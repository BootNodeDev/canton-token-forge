# Registry HTTP service configuration.
#
# Copy this file to `.env` and fill in the values for your environment:
#   cp .env.example .env
#
# `.env` is gitignored. Every variable without a default is required at boot;
# the service exits with "missing required env var <NAME>" if one is unset.
# Values already present in the real environment (containers, CI) take
# precedence over anything in `.env`.

# Canton JSON Ledger API base URL (no trailing path), e.g. http://localhost:7575
LEDGER_API_URL=

# Bearer token for the JSON Ledger API. SECRET: never commit a real value.
LEDGER_API_TOKEN=

# Ledger user submissions are made as. The service is read-only, so this is
# inert here; the seed records the value it used rather than reading it back,
# and takes its own from the process environment, never from this file.
# Optional, and deliberately so: a participant with
# authentication enabled derives the user from the token above and rejects a
# submission that names a different one, so leave this unset there. A
# participant running without authentication has no claims to default from and
# refuses every submission until it is set; the sandbox accepts
# `participant_admin`.
LEDGER_USER_ID=

# Instrument admin party id. Signs every InstrumentConfig, is the party the
# service reads the active contract set as, and is returned as `adminId` from
# GET /registry/metadata/v1/info.
ADMIN_PARTY=

# Concrete template ids, written in package-NAME form:
#   #<package-name>:<module>:<entity>
# e.g. '#canton-token-forge:Canton.TokenForge.Registry:InstrumentConfig'
#
# The participant rejects a package-id-qualified identifier with "Received an
# identifier with package ID ..., but expected a package name", so the service
# refuses to start unless each of these has the package-name form.
#
# Quote every value: the leading `#` is read as the start of a comment
# otherwise, and the variable silently parses as empty.
# `node scripts/seed.mjs` prints the whole block filled in and quoted.
#
# These are concrete template ids, never interface ids: the ledger client filters
# by template and the choice-context handlers read payload fields that exist on
# the template create arguments and not on the standard interface views.
INSTRUMENT_CONFIG_TEMPLATE_ID=
PREAPPROVAL_TEMPLATE_ID=
LOCKED_TOKEN_TEMPLATE_ID=
TRANSFER_INSTRUCTION_TEMPLATE_ID=
ALLOCATION_TEMPLATE_ID=

# TCP port to listen on. Optional; defaults to 8080.
PORT=8080

# Grace period in milliseconds for draining in-flight requests on SIGTERM or
# SIGINT before the remaining connections are force-closed. Optional; defaults
# to 8000. Must be a positive integer. Keep it below your container runtime's
# stop grace period (Docker: 10s, Kubernetes terminationGracePeriodSeconds: 30s)
# so drain finishes before the runtime sends SIGKILL.
SHUTDOWN_TIMEOUT_MS=8000

# How much of a preapproval's remaining window the transfer factory requires
# before it recommends a direct transfer, in milliseconds. Optional; defaults to
# 30000. Must be an integer between 0 and 3600000. It covers the client round
# trip, submission and sequencing latency, and tolerated clock skew between this
# host and the synchronizer, since the ledger re-checks the window when the
# sender submits. Preapprovals expiring within it are served as offers instead.
# Zero disables the margin.
DIRECT_TRANSFER_MARGIN_MS=30000
