module SpliceApp.Tests.SmokeTest where

import Daml.Script
import DA.Assert ((===))
import Splice.Scripts.Util (setupApp, setupUser, tap, getNormalizedBalance, runNextIssuance)
import SpliceApp (Greeting(..))

-- End-to-end smoke test. Proves in one shot that: the Splice deps are vendored,
-- the splice-amulet-test harness DAR is built and data-depended, `tap` funds a
-- party through the AmuletRegistry engine, and our own production DAR
-- (splice-app) is data-depended correctly from the test package.
test_smoke : Script ()
test_smoke = do
  app <- setupApp
  -- mirror the upstream ceremony so a fresh round is issuing before we tap
  runNextIssuance app
  alice <- setupUser app "alice" app.dso
  _ <- tap app alice 1000.0
  bal <- getNormalizedBalance alice.primaryParty
  assert (bal >= 1000.0)

  -- our production template is usable from the test package
  cid <- submit alice.primaryParty $
    createCmd Greeting with owner = alice.primaryParty, message = "hello"
  Some g <- queryContractId alice.primaryParty cid
  g.message === "hello"
