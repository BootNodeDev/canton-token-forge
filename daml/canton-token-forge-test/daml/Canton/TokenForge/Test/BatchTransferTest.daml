module Canton.TokenForge.Test.BatchTransferTest where

import Daml.Script
import DA.Assert ((===))
import DA.Foldable (forA_)
import DA.List (sort)
import DA.Optional (isNone)
import DA.Text qualified as T
import DA.TextMap qualified as TextMap
import DA.Time (time, addRelTime, microseconds)
import DA.Date (date, Month(Jan))
import Splice.Api.Token.HoldingV1 qualified as HoldingV1
import Splice.Api.Token.MetadataV1 (Metadata(..), emptyMetadata)
import Canton.TokenForge.Registry (InstrumentConfig, InstrumentConfig_Transfer(..))
import Canton.TokenForge.Token (Token(..))
import Canton.TokenForge.Transfer (TokenTransfer(..), TokenTransferOutput(..), TokenLock(..), CreatedHolding(..), tokenTransferControllers)
import Canton.TokenForge.Test.Util (lockToken, registerInstrument, runTransfer)

lockUntil : Time
lockUntil = time (date 2026 Jan 2) 0 0 0

-- The controller set is computed from the argument before anything is fetched,
-- which is what makes it impossible for the choice to create a holding for a
-- party that did not authorize the transaction. Sorted before comparing: the
-- set is what matters, not the order the parties happen to come out in.
controllersAreSenderReceiversAndHolders : Script ()
controllersAreSenderReceiversAndHolders = do
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  provider <- allocateParty "provider"

  -- an unlocked output names its receiver
  let plain = TokenTransfer with
        sender = alice
        inputs = []
        outputs = [ TokenTransferOutput with
                      receiver = bob; amount = 1.0; lock = None; meta = emptyMetadata ]
  sort (tokenTransferControllers plain) === sort [alice, bob]

  -- a locked output names its receiver and every one of its holders
  let locked = TokenTransfer with
        sender = alice
        inputs = []
        outputs = [ TokenTransferOutput with
                      receiver = bob; amount = 1.0
                      lock = Some TokenLock with
                        holders = [provider]; expiresAt = lockUntil; optContext = None
                      meta = emptyMetadata ]
  sort (tokenTransferControllers locked) === sort [alice, bob, provider]

  -- a party filling several roles at once appears exactly once
  let selfLock = TokenTransfer with
        sender = alice
        inputs = []
        outputs =
          [ TokenTransferOutput with
              receiver = alice; amount = 1.0; lock = None; meta = emptyMetadata
          , TokenTransferOutput with
              receiver = alice; amount = 1.0
              lock = Some TokenLock with
                holders = [alice, provider]; expiresAt = lockUntil; optContext = None
              meta = emptyMetadata
          ]
  sort (tokenTransferControllers selfLock) === sort [alice, provider]

memo : Metadata
memo = Metadata with values = TextMap.fromList [("memo", "vesting")]

-- Create a Token directly, which the mint helper cannot do with a memo
-- attached: InstrumentConfig_Mint always mints empty metadata.
tokenWithMeta : Party -> Party -> Decimal -> Metadata -> Script (ContractId Token)
tokenWithMeta admin owner amount meta =
  submit (actAs [admin, owner]) $ createCmd Token with
    admin; owner; instrumentId = "CC"; amount; meta

-- Locking is a self-transfer with a single locked output, which is how vesting
-- Accept locks the funder's holding. The memo has to survive it: it is what
-- keeps a transfer memo alive across an escrow.
selfTransferIntoOneLock : Script ()
selfTransferIntoOneLock = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  cfg <- registerInstrument admin "CC" "CC" "CC" 10 None
  tok <- tokenWithMeta admin alice 50.0 memo
  result <- runTransfer cfg admin (TokenTransfer with
    sender = alice
    inputs = [tok]
    outputs =
      [ TokenTransferOutput with
          receiver = alice; amount = 50.0
          lock = Some TokenLock with
            holders = [admin]; expiresAt = lockUntil; optContext = Some "vesting-escrow"
          meta = memo
      ])
  -- outputs exhaust the inputs exactly, so there is nothing to return
  result.senderChangeCid === None
  case result.createdHoldings of
    [TransferResultLockedToken lockedCid] -> do
      Some lv <- queryInterfaceContractId alice (toInterfaceContractId @HoldingV1.Holding lockedCid)
      lv.owner === alice
      lv.amount === 50.0
      ((.holders) <$> lv.lock) === Some [admin]
      ((.context) <$> lv.lock) === Some (Some "vesting-escrow")
      lv.meta === memo
    _ -> abort "expected a single locked output"

-- An unlocked output's memo is the caller's, exactly as a locked one's is, and
-- the sender's change is not: change is the sender's own funds coming back, so
-- it carries no delivered-value memo. Both halves need pinning here because
-- every other unlocked output in this file passes emptyMetadata, so replacing
-- `o.meta` with emptyMetadata on the unlocked branch, or leaking the caller's
-- memo onto the change, leaves the whole suite green.
unlockedOutputKeepsItsMemoAndChangeCarriesNone : Script ()
unlockedOutputKeepsItsMemoAndChangeCarriesNone = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  cfg <- registerInstrument admin "CC" "CC" "CC" 10 None
  tok <- tokenWithMeta admin alice 100.0 memo
  result <- runTransfer cfg admin (TokenTransfer with
    sender = alice
    inputs = [tok]
    outputs =
      [ TokenTransferOutput with
          receiver = bob; amount = 60.0; lock = None; meta = memo
      ])
  case result.createdHoldings of
    [TransferResultToken paidCid] -> do
      Some paid <- queryContractId bob paidCid
      paid.owner === bob
      paid.amount === 60.0
      paid.meta === memo
    _ -> abort "expected a single unlocked output"
  case result.senderChangeCid of
    Some changeCid -> do
      Some change <- queryContractId alice changeCid
      change.owner === alice
      change.amount === 40.0
      change.meta === emptyMetadata
    None -> abort "expected the sender to get change"

-- Vesting Withdraw: the escrow is unlocked, part is released to the
-- beneficiary, and the remainder is locked straight back. The positional match
-- is the ordering assertion: createdHoldings comes back in outputs order.
releaseAndRelockRemainder : Script ()
releaseAndRelockRemainder = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  provider <- allocateParty "provider"
  cfg <- registerInstrument admin "CC" "CC" "CC" 10 None
  tok <- tokenWithMeta admin alice 100.0 emptyMetadata
  result <- runTransfer cfg admin (TokenTransfer with
    sender = alice
    inputs = [tok]
    outputs =
      [ TokenTransferOutput with
          receiver = alice; amount = 30.0; lock = None; meta = emptyMetadata
      , TokenTransferOutput with
          receiver = alice; amount = 70.0
          lock = Some TokenLock with
            holders = [provider, alice]; expiresAt = lockUntil
            optContext = Some "vesting-withdraw-remainder"
          meta = emptyMetadata
      ])
  result.senderChangeCid === None
  case result.createdHoldings of
    [TransferResultToken releasedCid, TransferResultLockedToken relockedCid] -> do
      Some released <- queryContractId alice releasedCid
      released.amount === 30.0
      released.owner === alice
      Some relocked <- queryContractId alice relockedCid
      relocked.amount === 70.0
      -- alice is the receiver, so naming her a holder adds nothing to the
      -- owner authority LockedToken_Unlock already needs; the stored set is
      -- the honest one the Holding view reports (AmuletRules
      -- dedupOutputLockHolders).
      relocked.holders === [provider]
      relocked.optContext === Some "vesting-withdraw-remainder"
    _ -> abort "expected an unlocked release followed by a re-lock, in that order"

-- Vesting Cancel: the beneficiary's escrow is clawed back to the funder, part
-- unlocked and part re-locked to a DIFFERENT owner under a DIFFERENT holder
-- set. Nothing about the output parties is derived from the sender.
clawbackToDifferentOwnerAndHolders : Script ()
clawbackToDifferentOwnerAndHolders = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  funder <- allocateParty "funder"
  provider <- allocateParty "provider"
  cfg <- registerInstrument admin "CC" "CC" "CC" 10 None
  tok <- tokenWithMeta admin alice 100.0 emptyMetadata
  result <- runTransfer cfg admin (TokenTransfer with
    sender = alice
    inputs = [tok]
    outputs =
      [ TokenTransferOutput with
          receiver = funder; amount = 60.0; lock = None; meta = emptyMetadata
      , TokenTransferOutput with
          receiver = funder; amount = 40.0
          lock = Some TokenLock with
            holders = [provider]; expiresAt = lockUntil; optContext = Some "vesting-cancel-owed"
          meta = emptyMetadata
      ])
  result.senderChangeCid === None
  case result.createdHoldings of
    [TransferResultToken clawedCid, TransferResultLockedToken owedCid] -> do
      Some clawed <- queryContractId funder clawedCid
      clawed.owner === funder
      clawed.amount === 60.0
      Some owed <- queryContractId funder owedCid
      owed.owner === funder
      owed.amount === 40.0
      owed.holders === [provider]
    _ -> abort "expected an unlocked clawback followed by a re-lock, in that order"

-- Vesting Accept: several holdings merge into one lock and the leftover comes
-- back as change. Amulet does not require exact conservation and neither do we.
mergeInputsIntoOneLockWithChange : Script ()
mergeInputsIntoOneLockWithChange = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  provider <- allocateParty "provider"
  bob <- allocateParty "bob"
  cfg <- registerInstrument admin "CC" "CC" "CC" 10 None
  t1 <- tokenWithMeta admin alice 40.0 emptyMetadata
  t2 <- tokenWithMeta admin alice 30.0 emptyMetadata
  t3 <- tokenWithMeta admin alice 30.0 emptyMetadata
  result <- runTransfer cfg admin (TokenTransfer with
    sender = alice
    inputs = [t1, t2, t3]
    outputs =
      [ TokenTransferOutput with
          receiver = alice; amount = 90.0
          lock = Some TokenLock with
            holders = [provider, bob]; expiresAt = lockUntil; optContext = Some "vesting-escrow"
          meta = emptyMetadata
      ])
  case result.createdHoldings of
    [TransferResultLockedToken lockedCid] -> do
      Some locked <- queryContractId alice lockedCid
      locked.amount === 90.0
    _ -> abort "expected a single locked output"
  case result.senderChangeCid of
    Some changeCid -> do
      Some change <- queryContractId alice changeCid
      change.owner === alice
      change.amount === 10.0
    None -> abort "expected the leftover input value back as change"
  -- every input is gone
  forA_ [t1, t2, t3] \cid -> do
    spent <- queryContractId alice cid
    assertMsg "every input must be archived" (isNone spent)

-- No minting: outputs plus change equal the inputs exactly, so outputs beyond
-- the inputs must be refused. 50.01 is an arbitrary overspend, not a minimal
-- one: Decimal carries ten fractional digits, and the instrument's `decimals`
-- is never applied to an amount anywhere.
transferRejectsOutputsExceedingInputs : Script ()
transferRejectsOutputsExceedingInputs = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  cfg <- registerInstrument admin "CC" "CC" "CC" 10 None
  tok <- tokenWithMeta admin alice 50.0 emptyMetadata
  Some cfgDisclosure <- queryDisclosure admin cfg
  let transfer = TokenTransfer with
        sender = alice
        inputs = [tok]
        outputs = [ TokenTransferOutput with
                      receiver = alice; amount = 50.01; lock = None; meta = emptyMetadata ]
  submitMustFail (actAs (tokenTransferControllers transfer) <> disclose cfgDisclosure) $
    exerciseCmd cfg InstrumentConfig_Transfer with
      transfer; expectedAdmin = admin; expectedInstrumentId = "CC"

-- The stored holder list is normalized, so the standard's Lock.holders view
-- names each party once in a canonical order rather than echoing however the
-- caller happened to spell the set. releaseAndRelockRemainder pins the
-- receiver-strip half; these are the other two, and a bare `filter` passes
-- every other scenario in this file because none of them repeats a holder or
-- reads back the order of a set with more than one party left in it.
lockHoldersAreDedupedAndSorted : Script ()
lockHoldersAreDedupedAndSorted = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  first <- allocateParty "holder-one"
  second <- allocateParty "holder-two"
  cfg <- registerInstrument admin "CC" "CC" "CC" 10 None
  tok <- tokenWithMeta admin alice 50.0 emptyMetadata
  -- party ids carry an allocation suffix, so which of the two sorts first is
  -- not knowable here: derive it, then hand them over high-then-low with one
  -- repeated, which neither the caller's ordering nor a plain filter can satisfy
  [lo, hi] <- pure (sort [first, second])
  result <- runTransfer cfg admin (TokenTransfer with
    sender = alice
    inputs = [tok]
    outputs =
      [ TokenTransferOutput with
          receiver = alice; amount = 50.0
          lock = Some TokenLock with
            holders = [hi, lo, hi]; expiresAt = lockUntil; optContext = None
          meta = emptyMetadata
      ])
  case result.createdHoldings of
    [TransferResultLockedToken lockedCid] -> do
      Some lv <- queryInterfaceContractId alice (toInterfaceContractId @HoldingV1.Holding lockedCid)
      ((.holders) <$> lv.lock) === Some [lo, hi]
    _ -> abort "expected a single locked output"

-- A lock whose expiry has already passed is releasable by its owner alone the
-- moment it is created, since that is exactly the gate LockedToken_ExpireLock
-- opens. AmuletRules refuses to create one (preprocessOutputs) and so do we.
transferRejectsAnAlreadyExpiredLock : Script ()
transferRejectsAnAlreadyExpiredLock = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  provider <- allocateParty "provider"
  cfg <- registerInstrument admin "CC" "CC" "CC" 10 None
  tok <- tokenWithMeta admin alice 50.0 emptyMetadata
  Some cfgDisclosure <- queryDisclosure admin cfg
  let transfer = TokenTransfer with
        sender = alice
        inputs = [tok]
        outputs = [ TokenTransferOutput with
                      receiver = alice; amount = 50.0
                      lock = Some TokenLock with
                        holders = [provider]; expiresAt = lockUntil; optContext = None
                      meta = emptyMetadata ]
  -- the instant the lock expires, not merely past it: a lock expiring now is
  -- already expirable, so the refusal has to cover the boundary itself
  setTime lockUntil
  submitMustFail (actAs (tokenTransferControllers transfer) <> disclose cfgDisclosure) $
    exerciseCmd cfg InstrumentConfig_Transfer with
      transfer; expectedAdmin = admin; expectedInstrumentId = "CC"

-- The accepting side of that same instant. assertWithinDeadline refuses at
-- `lockUntil`, so it has to accept immediately before it: one microsecond
-- earlier the identical lock is created. Without this, a guard flipped to the
-- assertDeadlineExceeded direction would refuse every future-dated lock and the
-- refusal above would still pass, since every other accepting scenario here
-- runs at the default ledger time, decades away from the boundary.
transferAcceptsALockOneTickBeforeExpiry : Script ()
transferAcceptsALockOneTickBeforeExpiry = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  provider <- allocateParty "provider"
  cfg <- registerInstrument admin "CC" "CC" "CC" 10 None
  tok <- tokenWithMeta admin alice 50.0 emptyMetadata
  setTime (addRelTime lockUntil (microseconds (-1)))
  result <- runTransfer cfg admin (TokenTransfer with
    sender = alice
    inputs = [tok]
    outputs = [ TokenTransferOutput with
                  receiver = alice; amount = 50.0
                  lock = Some TokenLock with
                    holders = [provider]; expiresAt = lockUntil; optContext = None
                  meta = emptyMetadata ])
  case result.createdHoldings of
    [TransferResultLockedToken lockedCid] -> do
      Some locked <- queryContractId alice lockedCid
      locked.expiresAt === lockUntil
      locked.amount === 50.0
    _ -> abort "expected a single locked output"

-- Exercise the batch transfer as the transfer's own controller set and require
-- a refusal. The actor set is derived rather than passed in: submitting as
-- fewer parties than the transfer names is refused at the InstrumentConfig node
-- before the choice body runs, so a hand-written list that drifts out of step
-- would leave the negative green without ever reaching the guard it names.
transferMustFailAs
  : ContractId InstrumentConfig
  -> Party            -- ^ admin
  -> Party            -- ^ expectedAdmin
  -> TokenTransfer
  -> Script ()
transferMustFailAs cfg admin expectedAdmin transfer = do
  Some cfgDisclosure <- queryDisclosure admin cfg
  Some config <- queryContractId admin cfg
  submitMustFail (actAs (tokenTransferControllers transfer) <> disclose cfgDisclosure) $
    exerciseCmd cfg InstrumentConfig_Transfer with
      transfer; expectedAdmin; expectedInstrumentId = config.instrumentId

-- Like transferMustFailAs, but pins the rejection message. A refusal that is
-- guarded in depth needs this: the duplicate-input case below still fails with
-- its assert removed, on the ledger refusing the second archive of the same
-- contract, so a bare submitMustFail accepts a missing guard.
transferMustFailAsWith
  : ContractId InstrumentConfig
  -> Party            -- ^ admin
  -> [Party]          -- ^ actors
  -> Party            -- ^ expectedAdmin
  -> Text             -- ^ expected rejection message
  -> TokenTransfer
  -> Script ()
transferMustFailAsWith cfg admin actors expectedAdmin expectedMessage transfer = do
  Some cfgDisclosure <- queryDisclosure admin cfg
  Some config <- queryContractId admin cfg
  res <- trySubmit (actAs actors <> disclose cfgDisclosure) $
    exerciseCmd cfg InstrumentConfig_Transfer with
      transfer; expectedAdmin; expectedInstrumentId = config.instrumentId
  case res of
    Left (FailureStatusError fs) | expectedMessage `T.isInfixOf` fs.message -> pure ()
    _ -> abort ("expected a rejection matching " <> show expectedMessage <> ", got: " <> show res)

-- Whether an authorization message names the party as one it required and did
-- not get. It reports both sets in one sentence ("requires authorizers a,b, but
-- only a were given"), so an infix match over the whole message is satisfied by
-- a party that did authorize, and a case naming such a party would pin nothing.
requiredButNotGiven : Party -> Text -> Bool
requiredButNotGiven missing msg = case T.splitOn "but only" msg of
  [required, given] ->
    partyToText missing `T.isInfixOf` required && not (partyToText missing `T.isInfixOf` given)
  _ -> False

-- Like transferMustFailAs, but pins the refusal on the choice's own node. The
-- controller rule is guarded in depth: Token is `signatory admin, owner` and
-- LockedToken `signatory admin, owner, holders`, so dropping a party from
-- tokenTransferControllers still fails, only later and on the create of the
-- holding. Matching the InstrumentConfig node in the authorization message is
-- what tells the two apart. The constructor differs from transferMustFailAsWith's
-- because an authorization refusal is not a FailureStatusError. The missing
-- party is pinned as well: the node alone would still be refused if the choice
-- ever gained an unrelated controller, which would leave these cases green
-- while no longer binding on the output-party rule at all.
transferMustFailAsUnauthorized
  : ContractId InstrumentConfig
  -> Party            -- ^ admin
  -> [Party]          -- ^ actors
  -> Party            -- ^ the party whose authorization must be the one missing
  -> Party            -- ^ expectedAdmin
  -> TokenTransfer
  -> Script ()
transferMustFailAsUnauthorized cfg admin actors missing expectedAdmin transfer = do
  Some cfgDisclosure <- queryDisclosure admin cfg
  Some config <- queryContractId admin cfg
  res <- trySubmit (actAs actors <> disclose cfgDisclosure) $
    exerciseCmd cfg InstrumentConfig_Transfer with
      transfer; expectedAdmin; expectedInstrumentId = config.instrumentId
  case res of
    Left (AuthorizationError msg)
      | "Registry:InstrumentConfig" `T.isInfixOf` msg
      , requiredButNotGiven missing msg -> pure ()
    _ -> abort ("expected the InstrumentConfig node to require " <> show missing
                <> ", got: " <> show res)

-- No binding an unwilling party: a receiver and a lock holder are both
-- controllers, so a holding is never created for someone who did not sign.
-- This is stricter than the preapproval path, so it opens no bypass of it.
transferRequiresEveryOutputPartyToAuthorize : Script ()
transferRequiresEveryOutputPartyToAuthorize = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  provider <- allocateParty "provider"
  cfg <- registerInstrument admin "CC" "CC" "CC" 10 None
  tok <- tokenWithMeta admin alice 50.0 emptyMetadata

  -- an output receiver who does not authorize
  transferMustFailAsUnauthorized cfg admin [alice] bob admin (TokenTransfer with
    sender = alice
    inputs = [tok]
    outputs = [ TokenTransferOutput with
                  receiver = bob; amount = 50.0; lock = None; meta = emptyMetadata ])

  -- an output lock holder who does not authorize
  transferMustFailAsUnauthorized cfg admin [alice] provider admin (TokenTransfer with
    sender = alice
    inputs = [tok]
    outputs = [ TokenTransferOutput with
                  receiver = alice; amount = 50.0
                  lock = Some TokenLock with
                    holders = [provider]; expiresAt = lockUntil; optContext = None
                  meta = emptyMetadata ])

-- expectedAdmin is how a caller pins that it reached a config of the admin it
-- meant to. Which of that admin's instruments it reached is a separate pin, in
-- transferRejectsWrongExpectedInstrumentId below.
transferRejectsWrongExpectedAdmin : Script ()
transferRejectsWrongExpectedAdmin = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  cfg <- registerInstrument admin "CC" "CC" "CC" 10 None
  tok <- tokenWithMeta admin alice 50.0 emptyMetadata
  let transfer = TokenTransfer with
        sender = alice
        inputs = [tok]
        outputs = [ TokenTransferOutput with
                      receiver = alice; amount = 50.0; lock = None; meta = emptyMetadata ]
  transferMustFailAs cfg admin bob transfer

-- An admin may run several instruments and TokenTransfer names none of them, so
-- pinning the admin alone leaves a controller authorizing an amount with no
-- field saying which instrument it is paid in. Bob agrees to 50 CC; routing the
-- same argument through the same admin's XX config would pay him 50 XX.
transferRejectsWrongExpectedInstrumentId : Script ()
transferRejectsWrongExpectedInstrumentId = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  cfgCC <- registerInstrument admin "CC" "CC" "CC" 10 None
  cfgXX <- registerInstrument admin "XX" "XX" "XX" 10 None
  tokCC <- tokenWithMeta admin alice 50.0 emptyMetadata
  tokXX <- submit (actAs [admin, alice]) $ createCmd Token with
    admin; owner = alice; instrumentId = "XX"; amount = 50.0; meta = emptyMetadata

  let payBob input = TokenTransfer with
        sender = alice
        inputs = [input]
        outputs = [ TokenTransferOutput with
                      receiver = bob; amount = 50.0; lock = None; meta = emptyMetadata ]

  Some xxDisclosure <- queryDisclosure admin cfgXX
  res <- trySubmit (actAs (tokenTransferControllers (payBob tokXX)) <> disclose xxDisclosure) $
    exerciseCmd cfgXX InstrumentConfig_Transfer with
      transfer = payBob tokXX; expectedAdmin = admin; expectedInstrumentId = "CC"
  case res of
    Left (FailureStatusError fs)
      | "expectedInstrumentId must match the config instrument" `T.isInfixOf` fs.message -> pure ()
    _ -> abort ("expected the instrument pin to refuse, got: " <> show res)

  -- the control: the same shape against the config bob's authorization named
  result <- runTransfer cfgCC admin (payBob tokCC)
  [TransferResultToken paid] <- pure result.createdHoldings
  Some paidToken <- queryContractId bob paid
  paidToken.instrumentId === "CC"

-- consumeInputs enforces all five of these; none had been driven through this
-- entry point. The instrument guard is two conjuncts, so a holding of another
-- instrument and one of another admin's instrument of the SAME name are both
-- here: without the admin half, a second registry's "CC" would spend as ours.
-- The locked input is the one that matters most: a contract id is untyped at
-- runtime, so the coercion below is exactly what an attacker would write, and
-- fetchFromInterface's None branch is what refuses it. It is why an in-flight
-- TransferInstruction or Allocation escrow is unreachable here.
transferRejectsInputsItMayNotSpend : Script ()
transferRejectsInputsItMayNotSpend = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  cfg <- registerInstrument admin "CC" "CC" "CC" 10 None
  aliceTok <- tokenWithMeta admin alice 50.0 emptyMetadata
  bobTok <- tokenWithMeta admin bob 50.0 emptyMetadata
  foreignTok <- submit (actAs [admin, alice]) $ createCmd Token with
    admin; owner = alice; instrumentId = "XX"; amount = 50.0; meta = emptyMetadata
  otherAdmin <- allocateParty "otherAdmin"
  otherAdminTok <- submit (actAs [otherAdmin, alice]) $ createCmd Token with
    admin = otherAdmin; owner = alice; instrumentId = "CC"; amount = 50.0; meta = emptyMetadata
  toLock <- tokenWithMeta admin alice 50.0 emptyMetadata
  lockedCid <- lockToken cfg admin alice toLock [admin] lockUntil

  let spend cids amount = TokenTransfer with
        sender = alice
        inputs = cids
        outputs = [ TokenTransferOutput with
                      receiver = alice; amount; lock = None; meta = emptyMetadata ]

  -- an input not owned by the sender. bob is an output receiver, so his
  -- authority is delegated into the choice body and archiving his token is
  -- authorized; the ownership assert is what refuses it. Acting as bob in the
  -- submission would not be enough: only the controller set carries authority
  -- past the choice boundary.
  transferMustFailAsWith cfg admin [alice, bob] admin "input holding must be owned by the sender"
    (TokenTransfer with
      sender = alice
      inputs = [bobTok]
      outputs = [ TokenTransferOutput with
                    receiver = bob; amount = 50.0; lock = None; meta = emptyMetadata ])
  -- the same input twice
  transferMustFailAsWith cfg admin [alice] admin "input holdings must not contain duplicates"
    (spend [aliceTok, aliceTok] 100.0)
  -- an input of another instrument under the same admin
  transferMustFailAs cfg admin admin (spend [foreignTok] 50.0)
  -- an input of another admin's instrument of the same name. The foreign admin
  -- is an output receiver, so archiving his holding is authorized and the admin
  -- conjunct is the only thing refusing the spend: without it this transfer
  -- succeeds and mints our "CC" against a holding we never issued.
  transferMustFailAsWith cfg admin [alice, otherAdmin] admin
    "input holding must belong to this instrument"
    (TokenTransfer with
      sender = alice
      inputs = [otherAdminTok]
      outputs = [ TokenTransferOutput with
                    receiver = otherAdmin; amount = 50.0; lock = None; meta = emptyMetadata ])
  -- an escrowed LockedToken coerced into a Token cid. Pinned on the downcast's
  -- own refusal: an unchecked coercion in fetchInputs aborts on the wrongly
  -- typed contract, which a bare submitMustFail would accept as a pass.
  transferMustFailAsWith cfg admin [alice] admin "input holding is not a spendable Token"
    (spend [coerceContractId lockedCid] 50.0)

-- A negative output is the direction that matters: inputTotal >= outputTotal
-- still holds and inputTotal - outputTotal grows, so without the positivity
-- guard the sender's own change output inflates by the amount it hands away.
-- Token's `ensure amount > 0.0` refuses both cases too, which is why the
-- message is pinned rather than left to a bare submitMustFail.
transferRejectsNonPositiveOutputs : Script ()
transferRejectsNonPositiveOutputs = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  cfg <- registerInstrument admin "CC" "CC" "CC" 10 None

  negTok <- tokenWithMeta admin alice 50.0 emptyMetadata
  transferMustFailAsWith cfg admin [alice, bob] admin "output amount must be positive"
    (TokenTransfer with
      sender = alice
      inputs = [negTok]
      outputs =
        [ TokenTransferOutput with
            receiver = bob; amount = -10.0; lock = None; meta = emptyMetadata
        , TokenTransferOutput with
            receiver = alice; amount = 50.0; lock = None; meta = emptyMetadata ])

  zeroTok <- tokenWithMeta admin alice 50.0 emptyMetadata
  transferMustFailAsWith cfg admin [alice, bob] admin "output amount must be positive"
    (TokenTransfer with
      sender = alice
      inputs = [zeroTok]
      outputs = [ TokenTransferOutput with
                    receiver = bob; amount = 0.0; lock = None; meta = emptyMetadata ])
