module Canton.TokenForge.Test.Util where

import Daml.Script
import DA.TextMap qualified as TextMap
import Splice.Api.Token.MetadataV1 (emptyMetadata, ExtraArgs(..), ChoiceContext(..), AnyValue(..))
import Canton.TokenForge.Registry (InstrumentConfig(..), InstrumentConfig_Mint(..), FaucetConfig)
import Canton.TokenForge.Token (Token)
import Canton.TokenForge.Locked (expireLockContextKey)

-- | Create an instrument. The admin signs its own config, so registration is a
-- single create with no counterparty.
registerInstrument
  : Party            -- ^ admin
  -> Text            -- ^ instrumentId
  -> Text            -- ^ name
  -> Text            -- ^ symbol
  -> Int             -- ^ decimals
  -> Optional FaucetConfig
  -> Script (ContractId InstrumentConfig)
registerInstrument admin instrumentId name symbol decimals faucet =
  submit admin $ createCmd InstrumentConfig with
    admin; instrumentId; name; symbol; decimals; faucet; meta = emptyMetadata

-- | Mint `amount` of an instrument to `recipient`. The recipient co-authorizes
-- the mint because holdings are co-signed by their owner; admin authority
-- (admin is the config's signatory) carries the rest.
mintToken : ContractId InstrumentConfig -> Party -> Party -> Decimal -> Script (ContractId Token)
mintToken cfg admin recipient amount =
  submit (actAs [admin, recipient]) $ exerciseCmd cfg InstrumentConfig_Mint with recipient; amount

-- | Choice-context args carrying the early-release signal, so an escrow can be
-- returned before its deadline (Amulet's expire-lock path). Honored only by the
-- jointly-authorized allocation cancel.
expireLockArgs : ExtraArgs
expireLockArgs = ExtraArgs with
  context = ChoiceContext with values = TextMap.fromList [(expireLockContextKey, AV_Bool True)]
  meta = emptyMetadata
