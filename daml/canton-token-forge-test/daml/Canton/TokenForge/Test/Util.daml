module Canton.TokenForge.Test.Util where

import Daml.Script
import DA.TextMap qualified as TextMap
import Splice.Api.Token.MetadataV1 (emptyMetadata, ExtraArgs(..), ChoiceContext(..), AnyValue(..))
import Canton.TokenForge.Registry (InstrumentConfig(..), InstrumentConfig_Mint(..), InstrumentConfig_Preapprove(..), InstrumentConfig_Transfer(..), InstrumentConfig_TransferResult, TokenTransferPreapproval, FaucetConfig)
import Canton.TokenForge.Token (Token)
import Canton.TokenForge.Locked (LockedToken, expireLockContextKey, escrowReclaimedContextKey)
import Canton.TokenForge.Transfer (TokenTransfer(..), TokenTransferOutput(..), TokenLock(..), CreatedHolding(..), tokenTransferControllers)

-- | Create an instrument. The admin signs its own config, so registration is a
-- single create with no counterparty.
registerInstrument
  : Party            -- ^ admin
  -> Text            -- ^ instrumentId
  -> Text            -- ^ name
  -> Text            -- ^ symbol
  -> Int             -- ^ decimals
  -> Optional FaucetConfig
  -> Script (ContractId InstrumentConfig)
registerInstrument admin instrumentId name symbol decimals faucet =
  submit admin $ createCmd InstrumentConfig with
    admin; instrumentId; name; symbol; decimals; faucet; meta = emptyMetadata

-- | Mint `amount` of an instrument to `recipient`. The recipient co-authorizes
-- the mint because holdings are co-signed by their owner; admin authority
-- (admin is the config's signatory) carries the rest.
mintToken : ContractId InstrumentConfig -> Party -> Party -> Decimal -> Script (ContractId Token)
mintToken cfg admin recipient amount = do
  result <- submit (actAs [admin, recipient]) $ exerciseCmd cfg InstrumentConfig_Mint with recipient; amount
  pure result.tokenCid

-- | Opt `receiver` in to direct transfers. The receiver is the only controller,
-- and it is not a stakeholder of the config, so the config must be disclosed to
-- it the same way the faucet discloses it to a tapping party.
preapprove
  : ContractId InstrumentConfig
  -> Party           -- ^ admin
  -> Party           -- ^ receiver
  -> Time            -- ^ validFrom
  -> Time            -- ^ expiresAt
  -> Script (ContractId TokenTransferPreapproval)
preapprove cfg admin receiver validFrom expiresAt = do
  Some cfgDisclosure <- queryDisclosure admin cfg
  submit (actAs receiver <> disclose cfgDisclosure) $
    exerciseCmd cfg InstrumentConfig_Preapprove with receiver; validFrom; expiresAt

-- | Exercise the batch transfer acting as every party it names. The config is
-- not a stakeholder of any controller, so it is disclosed the same way the
-- faucet discloses it to a tapping party.
runTransfer
  : ContractId InstrumentConfig
  -> Party           -- ^ admin
  -> TokenTransfer
  -> Script InstrumentConfig_TransferResult
runTransfer cfg admin transfer = do
  Some cfgDisclosure <- queryDisclosure admin cfg
  Some config <- queryContractId admin cfg
  submit (actAs (tokenTransferControllers transfer) <> disclose cfgDisclosure) $
    exerciseCmd cfg InstrumentConfig_Transfer with
      transfer; expectedAdmin = admin; expectedInstrumentId = config.instrumentId

-- | Choice-context args carrying the early-release signal, so an escrow can be
-- returned before its deadline (Amulet's expire-lock path). Honored only by the
-- jointly-authorized allocation cancel.
expireLockArgs : ExtraArgs
expireLockArgs = ExtraArgs with
  context = ChoiceContext with values = TextMap.fromList [(expireLockContextKey, AV_Bool True)]
  meta = emptyMetadata

-- | Choice-context args reporting that the escrow behind a record is already
-- gone, which is what the registry answers once its owner has reclaimed it.
escrowReclaimedArgs : ExtraArgs
escrowReclaimedArgs = ExtraArgs with
  context = ChoiceContext with values = TextMap.fromList [(escrowReclaimedContextKey, AV_Bool True)]
  meta = emptyMetadata

-- | Lock `tokenCid` to `holders` until `expiresAt`, the way the batch transfer
-- expresses a lock: a self-transfer whose single output carries it. The token
-- is read back so its full amount and its memo carry into the lock, which is
-- what the choice this replaced did.
lockToken
  : ContractId InstrumentConfig
  -> Party            -- ^ admin
  -> Party            -- ^ owner
  -> ContractId Token
  -> [Party]          -- ^ holders
  -> Time
  -> Script (ContractId LockedToken)
lockToken cfg admin owner tokenCid holders expiresAt = do
  Some token <- queryContractId owner tokenCid
  result <- runTransfer cfg admin (TokenTransfer with
    sender = owner
    inputs = [tokenCid]
    outputs =
      [ TokenTransferOutput with
          receiver = owner; amount = token.amount
          lock = Some TokenLock with holders; expiresAt; optContext = None
          meta = token.meta
      ])
  case result.createdHoldings of
    [TransferResultLockedToken lockedCid] -> pure lockedCid
    _ -> abort "expected a single locked output"
