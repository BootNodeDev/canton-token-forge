module Canton.TokenForge.Test.Util where

import Daml.Script
import Canton.TokenForge.Registry (TokenRegistry(..), TokenRegistry_ProposeInstrument(..), InstrumentConfig, InstrumentConfigProposal, InstrumentConfigProposal_Accept(..), FaucetConfig)

-- | Propose an instrument through a fresh registry (disclosed to the admin so
-- the admin can drive the propose choice), returning the pending proposal
-- without accepting it. Lets a test then exercise accept, reject, or withdraw.
proposeInstrument
  : Party            -- ^ operator
  -> Party           -- ^ admin
  -> Text            -- ^ instrumentId
  -> Text            -- ^ name
  -> Text            -- ^ symbol
  -> Int             -- ^ decimals
  -> Optional FaucetConfig
  -> Script (ContractId InstrumentConfigProposal)
proposeInstrument operator admin instrumentId name symbol decimals faucet = do
  reg <- submit operator $ createCmd TokenRegistry with operator; registryBaseUrl = "http://r"
  Some regDisclosure <- queryDisclosure operator reg
  submit (actAs admin <> disclose regDisclosure) $ exerciseCmd reg TokenRegistry_ProposeInstrument with
    admin; instrumentId; name; symbol; decimals; faucet

-- | Register an instrument end to end: propose (admin) then accept (operator),
-- returning the created InstrumentConfig. One call replaces the two-step submit
-- across the suites.
registerInstrument
  : Party            -- ^ operator
  -> Party           -- ^ admin
  -> Text            -- ^ instrumentId
  -> Text            -- ^ name
  -> Text            -- ^ symbol
  -> Int             -- ^ decimals
  -> Optional FaucetConfig
  -> Script (ContractId InstrumentConfig)
registerInstrument operator admin instrumentId name symbol decimals faucet = do
  prop <- proposeInstrument operator admin instrumentId name symbol decimals faucet
  submit operator $ exerciseCmd prop InstrumentConfigProposal_Accept
