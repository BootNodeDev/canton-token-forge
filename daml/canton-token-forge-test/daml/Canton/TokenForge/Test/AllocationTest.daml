module Canton.TokenForge.Test.AllocationTest where

import Daml.Script
import DA.Assert ((===))
import DA.Optional (isNone, isSome)
import DA.Text qualified as T
import DA.TextMap qualified as TextMap
import DA.Time (time, addRelTime, microseconds)
import DA.Date (date, Month(Jan))
import Splice.Api.Token.HoldingV1 qualified as HoldingV1
import Splice.Api.Token.MetadataV1 (emptyMetadata, ExtraArgs(..), ChoiceContext(..), AnyValue(..), emptyChoiceContext)
import Splice.Api.Token.AllocationV1
import Splice.Api.Token.AllocationInstructionV1
import Canton.TokenForge.Types (mkInstrumentId)
import Canton.TokenForge.Allocation (TokenAllocation(..))
import Canton.TokenForge.Locked (LockedToken, LockedToken_ExpireLock(..), expireLockContextKey, escrowReclaimedContextKey)
import Canton.TokenForge.Test.Util (registerInstrument, mintToken, expireLockArgs, escrowReclaimedArgs)

-- Shared setup: register CC, mint 100 to alice, and build an allocation spec
-- for a 25.0 leg alice -> bob executed by venue.
allocateThenExecute : Script ()
allocateThenExecute = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  venue <- allocateParty "venue"
  cfg <- registerInstrument admin "CC" "CC" "CC" 10 None
  tok <- mintToken cfg admin alice 100.0

  let now = time (date 2026 Jan 1) 0 0 0
      later = time (date 2026 Jan 3) 0 0 0
      xargs = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata
      leg = TransferLeg with sender = alice; receiver = bob; amount = 25.0; instrumentId = mkInstrumentId admin "CC"; meta = emptyMetadata
      settlement = SettlementInfo with
        executor = venue; settlementRef = Reference with id = "s1"; cid = None
        requestedAt = now; allocateBefore = later; settleBefore = later; meta = emptyMetadata
      spec = AllocationSpecification with settlement; transferLegId = "leg1"; transferLeg = leg
  setTime now
  Some cfgDisclosure <- queryDisclosure admin cfg
  res <- submit (actAs alice <> disclose cfgDisclosure) $ exerciseCmd (toInterfaceContractId @AllocationFactory cfg) AllocationFactory_Allocate with
    expectedAdmin = admin; allocation = spec; requestedAt = now
    inputHoldingCids = [toInterfaceContractId @HoldingV1.Holding tok]; extraArgs = xargs
  allocCid <- case res.output of
    AllocationInstructionResult_Completed cid -> pure cid
    _ -> abort "expected completed allocation"
  -- the 75.0 unallocated remainder is returned to the sender as change
  [changeCid] <- pure res.senderChangeCids
  Some cv <- queryInterfaceContractId alice changeCid
  cv.owner === alice
  cv.amount === 75.0
  -- executor + sender + receiver settle the leg
  exec <- submit (actAs [venue, alice, bob]) $ exerciseCmd allocCid Allocation_ExecuteTransfer with extraArgs = xargs
  case exec.receiverHoldingCids of
    [rcid] -> do
      Some bv <- queryInterfaceContractId bob rcid
      bv.owner === bob
      bv.amount === 25.0
    _ -> abort "expected one receiver holding"

-- Once the settlement window has closed the sender can withdraw the unsettled
-- allocation and get their escrowed funds back. settleBefore itself is the
-- earliest instant that works, and the only one a strictly-after check would
-- refuse.
allocationWithdrawRefunds : Script ()
allocationWithdrawRefunds = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  venue <- allocateParty "venue"
  cfg <- registerInstrument admin "CC" "CC" "CC" 10 None
  tok <- mintToken cfg admin alice 100.0

  let now = time (date 2026 Jan 1) 0 0 0
      later = time (date 2026 Jan 3) 0 0 0
      xargs = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata
      leg = TransferLeg with sender = alice; receiver = bob; amount = 25.0; instrumentId = mkInstrumentId admin "CC"; meta = emptyMetadata
      settlement = SettlementInfo with
        executor = venue; settlementRef = Reference with id = "s1"; cid = None
        requestedAt = now; allocateBefore = later; settleBefore = later; meta = emptyMetadata
      spec = AllocationSpecification with settlement; transferLegId = "leg1"; transferLeg = leg
  setTime now
  Some cfgDisclosure <- queryDisclosure admin cfg
  res <- submit (actAs alice <> disclose cfgDisclosure) $ exerciseCmd (toInterfaceContractId @AllocationFactory cfg) AllocationFactory_Allocate with
    expectedAdmin = admin; allocation = spec; requestedAt = now
    inputHoldingCids = [toInterfaceContractId @HoldingV1.Holding tok]; extraArgs = xargs
  allocCid <- case res.output of
    AllocationInstructionResult_Completed cid -> pure cid
    _ -> abort "expected completed allocation"
  setTime later
  wd <- submit alice $ exerciseCmd allocCid Allocation_Withdraw with extraArgs = xargs
  case wd.senderHoldingCids of
    [rcid] -> do
      Some rv <- queryInterfaceContractId alice rcid
      rv.owner === alice
      rv.amount === 25.0
    _ -> abort "expected one refunded holding"

-- A caller-supplied expectedAdmin that does not match the config's admin is
-- rejected before any funds are touched.
allocationRejectsExpectedAdminMismatch : Script ()
allocationRejectsExpectedAdminMismatch = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  venue <- allocateParty "venue"
  cfg <- registerInstrument admin "CC" "CC" "CC" 10 None
  tok <- mintToken cfg admin alice 100.0

  let now = time (date 2026 Jan 1) 0 0 0
      later = time (date 2026 Jan 3) 0 0 0
      xargs = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata
      leg = TransferLeg with sender = alice; receiver = bob; amount = 25.0; instrumentId = mkInstrumentId admin "CC"; meta = emptyMetadata
      settlement = SettlementInfo with
        executor = venue; settlementRef = Reference with id = "s1"; cid = None
        requestedAt = now; allocateBefore = later; settleBefore = later; meta = emptyMetadata
      spec = AllocationSpecification with settlement; transferLegId = "leg1"; transferLeg = leg
  setTime now
  Some cfgDisclosure <- queryDisclosure admin cfg
  submitMustFail (actAs alice <> disclose cfgDisclosure) $ exerciseCmd (toInterfaceContractId @AllocationFactory cfg) AllocationFactory_Allocate with
    expectedAdmin = bob; allocation = spec; requestedAt = now
    inputHoldingCids = [toInterfaceContractId @HoldingV1.Holding tok]; extraArgs = xargs

-- The same input holding cid listed twice must be rejected rather than
-- silently double-spent.
allocationRejectsDuplicateInputs : Script ()
allocationRejectsDuplicateInputs = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  venue <- allocateParty "venue"
  cfg <- registerInstrument admin "CC" "CC" "CC" 10 None
  tok <- mintToken cfg admin alice 100.0

  let now = time (date 2026 Jan 1) 0 0 0
      later = time (date 2026 Jan 3) 0 0 0
      xargs = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata
      leg = TransferLeg with sender = alice; receiver = bob; amount = 25.0; instrumentId = mkInstrumentId admin "CC"; meta = emptyMetadata
      settlement = SettlementInfo with
        executor = venue; settlementRef = Reference with id = "s1"; cid = None
        requestedAt = now; allocateBefore = later; settleBefore = later; meta = emptyMetadata
      spec = AllocationSpecification with settlement; transferLegId = "leg1"; transferLeg = leg
  setTime now
  Some cfgDisclosure <- queryDisclosure admin cfg
  -- Matched on the message rather than submitMustFail: with the guard removed
  -- the submission still fails, on the ledger refusing the second archive of
  -- the same contract, so a bare submitMustFail accepts a missing guard.
  res <- trySubmit (actAs alice <> disclose cfgDisclosure) $ exerciseCmd (toInterfaceContractId @AllocationFactory cfg) AllocationFactory_Allocate with
    expectedAdmin = admin; allocation = spec; requestedAt = now
    inputHoldingCids =
      [ toInterfaceContractId @HoldingV1.Holding tok
      , toInterfaceContractId @HoldingV1.Holding tok
      ]
    extraArgs = xargs
  case res of
    Left (FailureStatusError fs) | "input holdings must not contain duplicates" `T.isInfixOf` fs.message -> pure ()
    _ -> abort ("expected the duplicate-input refusal, got: " <> show res)

-- From settleBefore on, the escrow is only sender-reclaimable; the executor can
-- no longer settle the leg even with full authorization. The same instant opens
-- the withdrawal above, so settlement is over the moment reclaim begins.
allocationExecuteAtSettleBeforeFails : Script ()
allocationExecuteAtSettleBeforeFails = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  venue <- allocateParty "venue"
  cfg <- registerInstrument admin "CC" "CC" "CC" 10 None
  tok <- mintToken cfg admin alice 100.0

  let now = time (date 2026 Jan 1) 0 0 0
      later = time (date 2026 Jan 3) 0 0 0
      xargs = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata
      leg = TransferLeg with sender = alice; receiver = bob; amount = 25.0; instrumentId = mkInstrumentId admin "CC"; meta = emptyMetadata
      settlement = SettlementInfo with
        executor = venue; settlementRef = Reference with id = "s1"; cid = None
        requestedAt = now; allocateBefore = later; settleBefore = later; meta = emptyMetadata
      spec = AllocationSpecification with settlement; transferLegId = "leg1"; transferLeg = leg
  setTime now
  Some cfgDisclosure <- queryDisclosure admin cfg
  res <- submit (actAs alice <> disclose cfgDisclosure) $ exerciseCmd (toInterfaceContractId @AllocationFactory cfg) AllocationFactory_Allocate with
    expectedAdmin = admin; allocation = spec; requestedAt = now
    inputHoldingCids = [toInterfaceContractId @HoldingV1.Holding tok]; extraArgs = xargs
  allocCid <- case res.output of
    AllocationInstructionResult_Completed cid -> pure cid
    _ -> abort "expected completed allocation"
  setTime later
  submitMustFail (actAs [venue, alice, bob]) $ exerciseCmd allocCid Allocation_ExecuteTransfer with extraArgs = xargs

-- requestedAt precedes settleBefore, so nothing the caller supplied is
-- self-contradictory, but ledger time has already reached it. The escrow would
-- be created at its own expiry, one LockedToken_ExpireLock away from the
-- sender's again, and allocation_executeTransferImpl requires
-- `now < settleBefore` so no executor could ever settle it. The instant itself,
-- not merely past it, since that is
-- the gate both the expire choice and the execute path open on.
allocationRejectsAnAlreadyReachedSettleBefore : Script ()
allocationRejectsAnAlreadyReachedSettleBefore = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  venue <- allocateParty "venue"
  cfg <- registerInstrument admin "CC" "CC" "CC" 10 None
  tok <- mintToken cfg admin alice 100.0

  let requestedAt = time (date 2026 Jan 1) 0 0 0
      settleAt = time (date 2026 Jan 2) 0 0 0
      allocEnd = time (date 2026 Jan 5) 0 0 0
      xargs = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata
      leg = TransferLeg with sender = alice; receiver = bob; amount = 25.0; instrumentId = mkInstrumentId admin "CC"; meta = emptyMetadata
      -- allocateBefore stays open so only the settlement deadline bites
      settlement = SettlementInfo with
        executor = venue; settlementRef = Reference with id = "s1"; cid = None
        requestedAt; allocateBefore = allocEnd; settleBefore = settleAt; meta = emptyMetadata
      spec = AllocationSpecification with settlement; transferLegId = "leg1"; transferLeg = leg
  setTime settleAt
  Some cfgDisclosure <- queryDisclosure admin cfg
  submitMustFail (actAs alice <> disclose cfgDisclosure) $ exerciseCmd (toInterfaceContractId @AllocationFactory cfg) AllocationFactory_Allocate with
    expectedAdmin = admin; allocation = spec; requestedAt
    inputHoldingCids = [toInterfaceContractId @HoldingV1.Holding tok]; extraArgs = xargs

-- The accepting side of that same instant. The deadline refuses at settleAt, so
-- it has to accept immediately before it: one microsecond earlier the identical
-- allocation completes. Without this, a guard flipped to the opposite direction
-- would refuse every allocation whose settlement window is still open and the
-- refusal above would still pass, since every other accepting scenario here
-- runs well inside its window.
allocationAcceptsOneTickBeforeSettleBefore : Script ()
allocationAcceptsOneTickBeforeSettleBefore = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  venue <- allocateParty "venue"
  cfg <- registerInstrument admin "CC" "CC" "CC" 10 None
  tok <- mintToken cfg admin alice 100.0

  let requestedAt = time (date 2026 Jan 1) 0 0 0
      settleAt = time (date 2026 Jan 2) 0 0 0
      allocEnd = time (date 2026 Jan 5) 0 0 0
      xargs = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata
      leg = TransferLeg with sender = alice; receiver = bob; amount = 25.0; instrumentId = mkInstrumentId admin "CC"; meta = emptyMetadata
      settlement = SettlementInfo with
        executor = venue; settlementRef = Reference with id = "s1"; cid = None
        requestedAt; allocateBefore = allocEnd; settleBefore = settleAt; meta = emptyMetadata
      spec = AllocationSpecification with settlement; transferLegId = "leg1"; transferLeg = leg
  setTime (addRelTime settleAt (microseconds (-1)))
  Some cfgDisclosure <- queryDisclosure admin cfg
  res <- submit (actAs alice <> disclose cfgDisclosure) $ exerciseCmd (toInterfaceContractId @AllocationFactory cfg) AllocationFactory_Allocate with
    expectedAdmin = admin; allocation = spec; requestedAt
    inputHoldingCids = [toInterfaceContractId @HoldingV1.Holding tok]; extraArgs = xargs
  allocCid <- case res.output of
    AllocationInstructionResult_Completed cid -> pure cid
    _ -> abort "expected completed allocation"
  Some alloc <- queryContractId admin (coerceContractId allocCid : ContractId TokenAllocation)
  Some locked <- queryContractId admin alloc.lockedCid
  locked.expiresAt === settleAt
  locked.amount === 25.0

-- The sender cannot withdraw the escrow while the settlement window is still
-- open. The early-release signal is a bare caller-supplied boolean, so forging
-- it must not bypass the deadline on this single-party path either - a
-- unilateral withdraw cannot break an in-flight settlement.
allocationWithdrawBeforeSettleFails : Script ()
allocationWithdrawBeforeSettleFails = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  venue <- allocateParty "venue"
  cfg <- registerInstrument admin "CC" "CC" "CC" 10 None
  tok <- mintToken cfg admin alice 100.0

  let now = time (date 2026 Jan 1) 0 0 0
      later = time (date 2026 Jan 3) 0 0 0
      xargs = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata
      leg = TransferLeg with sender = alice; receiver = bob; amount = 25.0; instrumentId = mkInstrumentId admin "CC"; meta = emptyMetadata
      settlement = SettlementInfo with
        executor = venue; settlementRef = Reference with id = "s1"; cid = None
        requestedAt = now; allocateBefore = later; settleBefore = later; meta = emptyMetadata
      spec = AllocationSpecification with settlement; transferLegId = "leg1"; transferLeg = leg
  setTime now
  Some cfgDisclosure <- queryDisclosure admin cfg
  res <- submit (actAs alice <> disclose cfgDisclosure) $ exerciseCmd (toInterfaceContractId @AllocationFactory cfg) AllocationFactory_Allocate with
    expectedAdmin = admin; allocation = spec; requestedAt = now
    inputHoldingCids = [toInterfaceContractId @HoldingV1.Holding tok]; extraArgs = xargs
  allocCid <- case res.output of
    AllocationInstructionResult_Completed cid -> pure cid
    _ -> abort "expected completed allocation"
  submitMustFail alice $ exerciseCmd allocCid Allocation_Withdraw with extraArgs = xargs
  submitMustFail alice $ exerciseCmd allocCid Allocation_Withdraw with extraArgs = expireLockArgs

-- With the joint parties' early-release signal, cancel returns the escrow to
-- the sender before settleBefore.
allocationCancelWithSignalReleasesEarly : Script ()
allocationCancelWithSignalReleasesEarly = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  venue <- allocateParty "venue"
  cfg <- registerInstrument admin "CC" "CC" "CC" 10 None
  tok <- mintToken cfg admin alice 100.0

  let now = time (date 2026 Jan 1) 0 0 0
      later = time (date 2026 Jan 3) 0 0 0
      xargs = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata
      leg = TransferLeg with sender = alice; receiver = bob; amount = 25.0; instrumentId = mkInstrumentId admin "CC"; meta = emptyMetadata
      settlement = SettlementInfo with
        executor = venue; settlementRef = Reference with id = "s1"; cid = None
        requestedAt = now; allocateBefore = later; settleBefore = later; meta = emptyMetadata
      spec = AllocationSpecification with settlement; transferLegId = "leg1"; transferLeg = leg
  setTime now
  Some cfgDisclosure <- queryDisclosure admin cfg
  res <- submit (actAs alice <> disclose cfgDisclosure) $ exerciseCmd (toInterfaceContractId @AllocationFactory cfg) AllocationFactory_Allocate with
    expectedAdmin = admin; allocation = spec; requestedAt = now
    inputHoldingCids = [toInterfaceContractId @HoldingV1.Holding tok]; extraArgs = xargs
  allocCid <- case res.output of
    AllocationInstructionResult_Completed cid -> pure cid
    _ -> abort "expected completed allocation"
  cancelRes <- submit (actAs [venue, alice, bob]) $ exerciseCmd allocCid Allocation_Cancel with extraArgs = expireLockArgs
  case cancelRes.senderHoldingCids of
    [rcid] -> do
      Some rv <- queryInterfaceContractId alice rcid
      rv.owner === alice
      rv.amount === 25.0
    _ -> abort "expected one refunded holding"

-- Without the signal, the joint parties cannot cancel before settleBefore, so a
-- premature cancel cannot break an in-flight settlement.
allocationCancelBeforeSettleWithoutSignalFails : Script ()
allocationCancelBeforeSettleWithoutSignalFails = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  venue <- allocateParty "venue"
  cfg <- registerInstrument admin "CC" "CC" "CC" 10 None
  tok <- mintToken cfg admin alice 100.0

  let now = time (date 2026 Jan 1) 0 0 0
      later = time (date 2026 Jan 3) 0 0 0
      xargs = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata
      leg = TransferLeg with sender = alice; receiver = bob; amount = 25.0; instrumentId = mkInstrumentId admin "CC"; meta = emptyMetadata
      settlement = SettlementInfo with
        executor = venue; settlementRef = Reference with id = "s1"; cid = None
        requestedAt = now; allocateBefore = later; settleBefore = later; meta = emptyMetadata
      spec = AllocationSpecification with settlement; transferLegId = "leg1"; transferLeg = leg
  setTime now
  Some cfgDisclosure <- queryDisclosure admin cfg
  res <- submit (actAs alice <> disclose cfgDisclosure) $ exerciseCmd (toInterfaceContractId @AllocationFactory cfg) AllocationFactory_Allocate with
    expectedAdmin = admin; allocation = spec; requestedAt = now
    inputHoldingCids = [toInterfaceContractId @HoldingV1.Holding tok]; extraArgs = xargs
  allocCid <- case res.output of
    AllocationInstructionResult_Completed cid -> pure cid
    _ -> abort "expected completed allocation"
  submitMustFail (actAs [venue, alice, bob]) $ exerciseCmd allocCid Allocation_Cancel with extraArgs = xargs

-- allocateBefore is exclusive, so an allocation cannot be created at the instant
-- its window closes. settleBefore stays open here, three days out, so the
-- settlement deadline cannot fire and this scenario reaches the allocation
-- window on its own; the message is matched because a bare submitMustFail here
-- accepts any refusal, which is how this guard came to have no test at all.
allocationRejectsAtAllocateBefore : Script ()
allocationRejectsAtAllocateBefore = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  venue <- allocateParty "venue"
  cfg <- registerInstrument admin "CC" "CC" "CC" 10 None
  tok <- mintToken cfg admin alice 100.0

  let now = time (date 2026 Jan 1) 0 0 0
      allocEnd = time (date 2026 Jan 3) 0 0 0
      settleAt = time (date 2026 Jan 6) 0 0 0
      xargs = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata
      leg = TransferLeg with sender = alice; receiver = bob; amount = 25.0; instrumentId = mkInstrumentId admin "CC"; meta = emptyMetadata
      settlement = SettlementInfo with
        executor = venue; settlementRef = Reference with id = "s1"; cid = None
        requestedAt = now; allocateBefore = allocEnd; settleBefore = settleAt; meta = emptyMetadata
      spec = AllocationSpecification with settlement; transferLegId = "leg1"; transferLeg = leg
  setTime allocEnd
  Some cfgDisclosure <- queryDisclosure admin cfg
  res <- trySubmit (actAs alice <> disclose cfgDisclosure) $ exerciseCmd (toInterfaceContractId @AllocationFactory cfg) AllocationFactory_Allocate with
    expectedAdmin = admin; allocation = spec; requestedAt = now
    inputHoldingCids = [toInterfaceContractId @HoldingV1.Holding tok]; extraArgs = xargs
  case res of
    Left (FailureStatusError fs) | "allocation window has closed" `T.isInfixOf` fs.message -> pure ()
    _ -> abort ("expected the allocation-window refusal, got: " <> show res)

-- The accepting side of that same instant: one microsecond before
-- allocateBefore the identical allocation completes. Without it a guard flipped
-- to the assertDeadlineExceeded direction would refuse every allocation whose
-- window is still open, and the refusal above would still pass.
allocationAcceptsOneTickBeforeAllocateBefore : Script ()
allocationAcceptsOneTickBeforeAllocateBefore = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  venue <- allocateParty "venue"
  cfg <- registerInstrument admin "CC" "CC" "CC" 10 None
  tok <- mintToken cfg admin alice 100.0

  let now = time (date 2026 Jan 1) 0 0 0
      allocEnd = time (date 2026 Jan 3) 0 0 0
      settleAt = time (date 2026 Jan 6) 0 0 0
      xargs = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata
      leg = TransferLeg with sender = alice; receiver = bob; amount = 25.0; instrumentId = mkInstrumentId admin "CC"; meta = emptyMetadata
      settlement = SettlementInfo with
        executor = venue; settlementRef = Reference with id = "s1"; cid = None
        requestedAt = now; allocateBefore = allocEnd; settleBefore = settleAt; meta = emptyMetadata
      spec = AllocationSpecification with settlement; transferLegId = "leg1"; transferLeg = leg
  setTime (addRelTime allocEnd (microseconds (-1)))
  Some cfgDisclosure <- queryDisclosure admin cfg
  res <- submit (actAs alice <> disclose cfgDisclosure) $ exerciseCmd (toInterfaceContractId @AllocationFactory cfg) AllocationFactory_Allocate with
    expectedAdmin = admin; allocation = spec; requestedAt = now
    inputHoldingCids = [toInterfaceContractId @HoldingV1.Holding tok]; extraArgs = xargs
  case res.output of
    AllocationInstructionResult_Completed _ -> pure ()
    _ -> abort "expected completed allocation"

allocStart : Time
allocStart = time (date 2026 Jan 1) 0 0 0

-- Both the allocation and the settlement windows close here, matching the
-- single deadline the scenarios above share.
allocSettle : Time
allocSettle = time (date 2026 Jan 3) 0 0 0

-- Shared setup for the reclaimed-escrow scenarios: allocate 25.0 of CC from
-- alice to bob through venue, and hand back the allocation with the escrow
-- behind it, which no other scenario needs to name.
startAllocation : Party -> Party -> Party -> Party -> Script (ContractId Allocation, ContractId LockedToken)
startAllocation admin alice bob venue = do
  cfg <- registerInstrument admin "CC" "CC" "CC" 10 None
  tok <- mintToken cfg admin alice 100.0
  let xargs = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata
      leg = TransferLeg with sender = alice; receiver = bob; amount = 25.0; instrumentId = mkInstrumentId admin "CC"; meta = emptyMetadata
      settlement = SettlementInfo with
        executor = venue; settlementRef = Reference with id = "s1"; cid = None
        requestedAt = allocStart; allocateBefore = allocSettle; settleBefore = allocSettle; meta = emptyMetadata
      spec = AllocationSpecification with settlement; transferLegId = "leg1"; transferLeg = leg
  setTime allocStart
  Some cfgDisclosure <- queryDisclosure admin cfg
  res <- submit (actAs alice <> disclose cfgDisclosure) $ exerciseCmd (toInterfaceContractId @AllocationFactory cfg) AllocationFactory_Allocate with
    expectedAdmin = admin; allocation = spec; requestedAt = allocStart
    inputHoldingCids = [toInterfaceContractId @HoldingV1.Holding tok]; extraArgs = xargs
  allocCid <- case res.output of
    AllocationInstructionResult_Completed cid -> pure cid
    _ -> abort "expected completed allocation"
  Some alloc <- queryContractId admin (coerceContractId allocCid : ContractId TokenAllocation)
  Some locked <- queryContractId admin alloc.lockedCid
  locked.optContext === Some ("allocation for transfer leg \"leg1\" to " <> partyToText bob)
  pure (allocCid, alloc.lockedCid)

-- The sender withdrawing an allocation whose escrow they already reclaimed
-- still clears the record: there is nothing to refund, so no holding comes back
-- and the allocation is archived rather than left unconsumable.
allocationWithdrawClearsRecordAfterEscrowReclaim : Script ()
allocationWithdrawClearsRecordAfterEscrowReclaim = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  venue <- allocateParty "venue"
  (allocCid, lockedCid) <- startAllocation admin alice bob venue
  setTime allocSettle
  _ <- submit alice $ exerciseCmd lockedCid LockedToken_ExpireLock
  wd <- submit alice $ exerciseCmd allocCid Allocation_Withdraw with extraArgs = escrowReclaimedArgs
  wd.senderHoldingCids === []
  gone <- queryContractId admin (coerceContractId allocCid : ContractId TokenAllocation)
  assertMsg "the withdrawn allocation is archived" (isNone gone)

-- The same through the jointly-authorized cancel, which is the other abort the
-- executor and counterparties can reach.
allocationCancelClearsRecordAfterEscrowReclaim : Script ()
allocationCancelClearsRecordAfterEscrowReclaim = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  venue <- allocateParty "venue"
  (allocCid, lockedCid) <- startAllocation admin alice bob venue
  setTime allocSettle
  _ <- submit alice $ exerciseCmd lockedCid LockedToken_ExpireLock
  cancel <- submit (actAs [venue, alice, bob]) $ exerciseCmd allocCid Allocation_Cancel with extraArgs = escrowReclaimedArgs
  cancel.senderHoldingCids === []
  gone <- queryContractId admin (coerceContractId allocCid : ContractId TokenAllocation)
  assertMsg "the cancelled allocation is archived" (isNone gone)

-- Both signals at once, which is how a cancel clears a record whose escrow is
-- already gone before settleBefore: the report says there is nothing to return,
-- the early-release signal is the joint authorization to act before the
-- deadline. The two answer different questions, so neither overrides the other.
bothSignalArgs : ExtraArgs
bothSignalArgs = ExtraArgs with
  context = ChoiceContext with
    values = TextMap.fromList
      [ (expireLockContextKey, AV_Bool True)
      , (escrowReclaimedContextKey, AV_Bool True)
      ]
  meta = emptyMetadata

-- Reporting a reclaimed escrow must not buy an early abort while the escrow is
-- still sitting there: each abort applies to the reported branch the same gate
-- its escrow-returning branch enforces. The single-party withdraw is
-- deadline-gated either way, and so is a cancel that carries no early-release
-- signal.
allocationAbortWithoutEscrowStillNeedsTheDeadline : Script ()
allocationAbortWithoutEscrowStillNeedsTheDeadline = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  venue <- allocateParty "venue"
  (allocCid, _) <- startAllocation admin alice bob venue
  submitMustFail alice $ exerciseCmd allocCid Allocation_Withdraw with extraArgs = escrowReclaimedArgs
  submitMustFail (actAs [venue, alice, bob]) $ exerciseCmd allocCid Allocation_Cancel with extraArgs = escrowReclaimedArgs

-- A cancel carrying both signals may clear the record before settleBefore,
-- because the same three parties could have released the escrow outright. When
-- the report is wrong the escrow simply stays locked until its own deadline,
-- and the funds are the sender's own: she is one of the three authorizing it.
allocationCancelClearsRecordEarlyWithBothSignals : Script ()
allocationCancelClearsRecordEarlyWithBothSignals = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  venue <- allocateParty "venue"
  (allocCid, lockedCid) <- startAllocation admin alice bob venue
  cancel <- submit (actAs [venue, alice, bob]) $ exerciseCmd allocCid Allocation_Cancel with extraArgs = bothSignalArgs
  cancel.senderHoldingCids === []
  gone <- queryContractId admin (coerceContractId allocCid : ContractId TokenAllocation)
  assertMsg "the cancelled allocation is archived" (isNone gone)
  stillLocked <- queryContractId admin lockedCid
  assertMsg "a report against a live escrow leaves it locked" (isSome stillLocked)
