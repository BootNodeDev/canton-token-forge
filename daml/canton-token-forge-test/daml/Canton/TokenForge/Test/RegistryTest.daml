module Canton.TokenForge.Test.RegistryTest where

import Daml.Script
import DA.Assert ((===))
import Splice.Api.Token.HoldingV1 qualified as HoldingV1
import Splice.Api.Token.MetadataV1 (emptyMetadata)
import Canton.TokenForge.Registry (InstrumentConfig(..))
import Canton.TokenForge.Test.Util (registerInstrument, mintToken)

-- The admin creates its own config and mints from it.
createInstrumentMints : Script ()
createInstrumentMints = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"

  cfg <- registerInstrument admin "CC" "Canton Coin" "CC" 10 None

  tokenCid <- mintToken cfg admin alice 42.0
  let hcid = toInterfaceContractId @HoldingV1.Holding tokenCid
  Some hv <- queryInterfaceContractId alice hcid
  hv.owner === alice
  hv.amount === 42.0
  hv.instrumentId === HoldingV1.InstrumentId with admin; id = "CC"

-- The config is admin-signed, so no other party can bring one into existence
-- naming that admin.
createRequiresAdminAuthority : Script ()
createRequiresAdminAuthority = do
  admin <- allocateParty "admin"
  stranger <- allocateParty "stranger"
  submitMustFail stranger $ createCmd InstrumentConfig with
    admin; instrumentId = "CC"; name = "Canton Coin"; symbol = "CC"
    decimals = 10; faucet = None; meta = emptyMetadata

-- The template's `ensure` is the only creation-time guard on an instrument.
createRejectsBadDecimals : Script ()
createRejectsBadDecimals = do
  admin <- allocateParty "admin"
  submitMustFail admin $ createCmd InstrumentConfig with
    admin; instrumentId = "CC"; name = "Canton Coin"; symbol = "CC"
    decimals = 19; faucet = None; meta = emptyMetadata
