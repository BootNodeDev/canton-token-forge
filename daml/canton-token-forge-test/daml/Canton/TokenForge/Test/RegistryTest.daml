module Canton.TokenForge.Test.RegistryTest where

import Daml.Script
import DA.Assert ((===))
import Splice.Api.Token.HoldingV1 qualified as HoldingV1
import Canton.TokenForge.Registry (TokenRegistry(..), TokenRegistry_ProposeInstrument(..), InstrumentConfigProposal_Accept(..), InstrumentConfigProposal_Reject(..), InstrumentConfigProposal_Withdraw(..), InstrumentConfig_Mint(..))
import Canton.TokenForge.Test.Util (proposeInstrument)

-- Admin proposes through the registry, operator accepts, and the resulting
-- InstrumentConfig mints.
proposeAcceptCreatesInstrument : Script ()
proposeAcceptCreatesInstrument = do
  operator <- allocateParty "operator"
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"

  prop <- proposeInstrument operator admin "CC" "Canton Coin" "CC" 10 None
  cfg <- submit operator $ exerciseCmd prop InstrumentConfigProposal_Accept

  tokenCid <- submit admin $ exerciseCmd cfg InstrumentConfig_Mint with recipient = alice; amount = 42.0
  let hcid = toInterfaceContractId @HoldingV1.Holding tokenCid
  Some hv <- queryInterfaceContractId alice hcid
  hv.owner === alice
  hv.amount === 42.0
  hv.instrumentId === HoldingV1.InstrumentId with admin; id = "CC"

-- Finalizing needs the operator's authority: the admin cannot self-approve.
acceptRequiresOperator : Script ()
acceptRequiresOperator = do
  operator <- allocateParty "operator"
  admin <- allocateParty "admin"
  prop <- proposeInstrument operator admin "CC" "Canton Coin" "CC" 10 None
  submitMustFail admin $ exerciseCmd prop InstrumentConfigProposal_Accept

-- Proposing is admin-controlled: the operator alone cannot drive
-- TokenRegistry_ProposeInstrument on the admin's behalf.
proposeRequiresAdmin : Script ()
proposeRequiresAdmin = do
  operator <- allocateParty "operator"
  admin <- allocateParty "admin"
  reg <- submit operator $ createCmd TokenRegistry with operator; registryBaseUrl = "http://r"
  submitMustFail operator $ exerciseCmd reg TokenRegistry_ProposeInstrument with
    admin; instrumentId = "CC"; name = "Canton Coin"; symbol = "CC"; decimals = 10; faucet = None

-- The operator can decline: no InstrumentConfig results and the proposal is gone.
rejectDiscardsProposal : Script ()
rejectDiscardsProposal = do
  operator <- allocateParty "operator"
  admin <- allocateParty "admin"
  prop <- proposeInstrument operator admin "CC" "Canton Coin" "CC" 10 None
  submit operator $ exerciseCmd prop InstrumentConfigProposal_Reject
  None <- queryContractId admin prop
  pure ()

-- The admin can retract a still-pending proposal.
withdrawByAdmin : Script ()
withdrawByAdmin = do
  operator <- allocateParty "operator"
  admin <- allocateParty "admin"
  prop <- proposeInstrument operator admin "CC" "Canton Coin" "CC" 10 None
  submit admin $ exerciseCmd prop InstrumentConfigProposal_Withdraw
  None <- queryContractId admin prop
  pure ()

-- Out-of-range decimals are rejected at propose time by the proposal's ensure.
proposeRejectsBadDecimals : Script ()
proposeRejectsBadDecimals = do
  operator <- allocateParty "operator"
  admin <- allocateParty "admin"
  reg <- submit operator $ createCmd TokenRegistry with operator; registryBaseUrl = "http://r"
  Some regDisclosure <- queryDisclosure operator reg
  submitMustFail (actAs admin <> disclose regDisclosure) $ exerciseCmd reg TokenRegistry_ProposeInstrument with
    admin; instrumentId = "CC"; name = "Canton Coin"; symbol = "CC"; decimals = 19; faucet = None
