module Canton.TokenForge.Test.FaucetTest where

import Daml.Script
import DA.Assert ((===))
import Splice.Api.Token.HoldingV1 qualified as HoldingV1
import Canton.TokenForge.Registry (FaucetConfig(..), InstrumentConfig_Tap(..))
import Canton.TokenForge.Test.Util (registerInstrument)

faucetTapWorksWithinCap : Script ()
faucetTapWorksWithinCap = do
  operator <- allocateParty "operator"
  admin <- allocateParty "admin"
  user <- allocateParty "user"

  cfg <- registerInstrument operator admin "CC" "CC" "CC" 10 (Some FaucetConfig with maxPerTap = 100.0)

  Some cfgDisclosure <- queryDisclosure admin cfg
  tok <- submit (actAs user <> disclose cfgDisclosure) $ exerciseCmd cfg InstrumentConfig_Tap with user; amount = 100.0
  Some hv <- queryInterfaceContractId user (toInterfaceContractId @HoldingV1.Holding tok)
  hv.owner === user
  hv.amount === 100.0

faucetTapRejectsOverCap : Script ()
faucetTapRejectsOverCap = do
  operator <- allocateParty "operator"
  admin <- allocateParty "admin"
  user <- allocateParty "user"

  cfg <- registerInstrument operator admin "CC" "CC" "CC" 10 (Some FaucetConfig with maxPerTap = 10.0)

  Some cfgDisclosure <- queryDisclosure admin cfg
  submitMustFail (actAs user <> disclose cfgDisclosure) $ exerciseCmd cfg InstrumentConfig_Tap with user; amount = 50.0

faucetTapRejectsWhenDisabled : Script ()
faucetTapRejectsWhenDisabled = do
  operator <- allocateParty "operator"
  admin <- allocateParty "admin"
  user <- allocateParty "user"

  cfg <- registerInstrument operator admin "CC" "CC" "CC" 10 None

  Some cfgDisclosure <- queryDisclosure admin cfg
  submitMustFail (actAs user <> disclose cfgDisclosure) $ exerciseCmd cfg InstrumentConfig_Tap with user; amount = 5.0
