module Canton.TokenForge.Test.FaucetTest where

import Daml.Script
import DA.Assert ((===))
import Splice.Api.Token.HoldingV1 qualified as HoldingV1
import Canton.TokenForge.Registry (TokenRegistry(..), TokenRegistry_RegisterInstrument(..), FaucetConfig(..), Tap(..))

faucetTapWorksWithinCap : Script ()
faucetTapWorksWithinCap = do
  operator <- allocateParty "operator"
  admin <- allocateParty "admin"
  user <- allocateParty "user"

  reg <- submit operator $ createCmd TokenRegistry with operator; registryBaseUrl = "http://r"
  cfg <- submit (actAs [operator, admin]) $ exerciseCmd reg TokenRegistry_RegisterInstrument with
    admin; instrumentId = "CC"; name = "CC"; symbol = "CC"; decimals = 10
    faucet = Some FaucetConfig with maxPerTap = 100.0

  Some cfgDisclosure <- queryDisclosure admin cfg
  tok <- submit (actAs user <> disclose cfgDisclosure) $ exerciseCmd cfg Tap with user; amount = 100.0
  Some hv <- queryInterfaceContractId user (toInterfaceContractId @HoldingV1.Holding tok)
  hv.owner === user
  hv.amount === 100.0

faucetTapRejectsOverCap : Script ()
faucetTapRejectsOverCap = do
  operator <- allocateParty "operator"
  admin <- allocateParty "admin"
  user <- allocateParty "user"

  reg <- submit operator $ createCmd TokenRegistry with operator; registryBaseUrl = "http://r"
  cfg <- submit (actAs [operator, admin]) $ exerciseCmd reg TokenRegistry_RegisterInstrument with
    admin; instrumentId = "CC"; name = "CC"; symbol = "CC"; decimals = 10
    faucet = Some FaucetConfig with maxPerTap = 10.0

  Some cfgDisclosure <- queryDisclosure admin cfg
  submitMustFail (actAs user <> disclose cfgDisclosure) $ exerciseCmd cfg Tap with user; amount = 50.0

faucetTapRejectsWhenDisabled : Script ()
faucetTapRejectsWhenDisabled = do
  operator <- allocateParty "operator"
  admin <- allocateParty "admin"
  user <- allocateParty "user"

  reg <- submit operator $ createCmd TokenRegistry with operator; registryBaseUrl = "http://r"
  cfg <- submit (actAs [operator, admin]) $ exerciseCmd reg TokenRegistry_RegisterInstrument with
    admin; instrumentId = "CC"; name = "CC"; symbol = "CC"; decimals = 10; faucet = None

  Some cfgDisclosure <- queryDisclosure admin cfg
  submitMustFail (actAs user <> disclose cfgDisclosure) $ exerciseCmd cfg Tap with user; amount = 5.0
