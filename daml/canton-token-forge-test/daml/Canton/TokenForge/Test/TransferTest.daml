module Canton.TokenForge.Test.TransferTest where

import Daml.Script
import DA.Assert ((===))
import DA.List (head)
import DA.TextMap qualified as TextMap
import DA.Time (time)
import DA.Date (date, Month(Jan))
import Splice.Api.Token.HoldingV1 qualified as HoldingV1
import Splice.Api.Token.MetadataV1 (Metadata(..), emptyMetadata, ExtraArgs(..), ChoiceContext(..), AnyValue(..))
import Splice.Api.Token.TransferInstructionV1
import Canton.TokenForge.Types (mkInstrumentId)
import Canton.TokenForge.Registry (InstrumentConfig_Preapprove(..), InstrumentConfig_LockHolding(..), preapprovalContextKey)
import Canton.TokenForge.Test.Util (registerInstrument, mintToken)

directTransferCompletes : Script ()
directTransferCompletes = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"

  cfg <- registerInstrument admin "CC" "Canton Coin" "CC" 10 None
  aliceToken <- mintToken cfg admin alice 100.0

  let now = time (date 2026 Jan 1) 0 0 0
      later = time (date 2026 Jan 2) 0 0 0
  setTime now
  -- bob opts in to direct transfers (enables 1-step completion)
  pre <- submit (actAs [admin, bob]) $ exerciseCmd cfg InstrumentConfig_Preapprove with
    receiver = bob; validFrom = now; expiresAt = later

  let factoryCid = toInterfaceContractId @TransferFactory cfg
      transfer = Transfer with
        sender = alice; receiver = bob; amount = 30.0
        instrumentId = mkInstrumentId admin "CC"
        requestedAt = now; executeBefore = later
        inputHoldingCids = [toInterfaceContractId @HoldingV1.Holding aliceToken]
        meta = emptyMetadata
      -- the app backend hands the preapproval cid to the choice via the context
      ctx = ChoiceContext with
        values = TextMap.fromList [(preapprovalContextKey, AV_ContractId (coerceContractId pre))]
  Some cfgDisclosure <- queryDisclosure admin cfg
  Some preDisclosure <- queryDisclosure admin pre
  result <- submit (actAs alice <> disclose cfgDisclosure <> disclose preDisclosure) $
    exerciseCmd factoryCid TransferFactory_Transfer with
      expectedAdmin = admin; transfer; extraArgs = ExtraArgs with context = ctx; meta = emptyMetadata

  case result.output of
    TransferInstructionResult_Completed receiverHoldingCids -> do
      Some bv <- queryInterfaceContractId bob (head receiverHoldingCids)
      bv.owner === bob
      bv.amount === 30.0
    _ -> abort "expected completed transfer"
  [changeCid] <- pure result.senderChangeCids
  Some cv <- queryInterfaceContractId alice changeCid
  cv.amount === 70.0

-- A memo carried in transfer.meta reaches the receiver's delivered holding.
directTransferPropagatesMeta : Script ()
directTransferPropagatesMeta = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"

  cfg <- registerInstrument admin "CC" "Canton Coin" "CC" 10 None
  aliceToken <- mintToken cfg admin alice 100.0

  let now = time (date 2026 Jan 1) 0 0 0
      later = time (date 2026 Jan 2) 0 0 0
  setTime now
  pre <- submit (actAs [admin, bob]) $ exerciseCmd cfg InstrumentConfig_Preapprove with
    receiver = bob; validFrom = now; expiresAt = later

  let memo = Metadata with values = TextMap.fromList [("memo", "invoice-42")]
      factoryCid = toInterfaceContractId @TransferFactory cfg
      transfer = Transfer with
        sender = alice; receiver = bob; amount = 30.0
        instrumentId = mkInstrumentId admin "CC"
        requestedAt = now; executeBefore = later
        inputHoldingCids = [toInterfaceContractId @HoldingV1.Holding aliceToken]
        meta = memo
      ctx = ChoiceContext with
        values = TextMap.fromList [(preapprovalContextKey, AV_ContractId (coerceContractId pre))]
  Some cfgDisclosure <- queryDisclosure admin cfg
  Some preDisclosure <- queryDisclosure admin pre
  result <- submit (actAs alice <> disclose cfgDisclosure <> disclose preDisclosure) $
    exerciseCmd factoryCid TransferFactory_Transfer with
      expectedAdmin = admin; transfer; extraArgs = ExtraArgs with context = ctx; meta = emptyMetadata

  case result.output of
    TransferInstructionResult_Completed receiverHoldingCids -> do
      Some bv <- queryInterfaceContractId bob (head receiverHoldingCids)
      bv.meta === memo
    _ -> abort "expected completed transfer"

-- expectedAdmin mismatch, non-positive amount, duplicate inputs, and a locked
-- input are all rejected.
transferRejectsBadInputs : Script ()
transferRejectsBadInputs = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"

  cfg <- registerInstrument admin "CC" "Canton Coin" "CC" 10 None
  aliceToken <- mintToken cfg admin alice 100.0

  let now = time (date 2026 Jan 1) 0 0 0
      later = time (date 2026 Jan 2) 0 0 0
  setTime now
  pre <- submit (actAs [admin, bob]) $ exerciseCmd cfg InstrumentConfig_Preapprove with
    receiver = bob; validFrom = now; expiresAt = later

  let factoryCid = toInterfaceContractId @TransferFactory cfg
      ctx = ChoiceContext with
        values = TextMap.fromList [(preapprovalContextKey, AV_ContractId (coerceContractId pre))]
      mkTransfer amt = Transfer with
        sender = alice; receiver = bob; amount = amt
        instrumentId = mkInstrumentId admin "CC"
        requestedAt = now; executeBefore = later
        inputHoldingCids = [toInterfaceContractId @HoldingV1.Holding aliceToken]
        meta = emptyMetadata
      xargs = ExtraArgs with context = ctx; meta = emptyMetadata
  Some cfgDisclosure <- queryDisclosure admin cfg
  Some preDisclosure <- queryDisclosure admin pre
  let disclosures = disclose cfgDisclosure <> disclose preDisclosure

  -- wrong expectedAdmin
  submitMustFail (actAs alice <> disclosures) $ exerciseCmd factoryCid TransferFactory_Transfer with
    expectedAdmin = bob; transfer = mkTransfer 30.0; extraArgs = xargs
  -- non-positive amount
  submitMustFail (actAs alice <> disclosures) $ exerciseCmd factoryCid TransferFactory_Transfer with
    expectedAdmin = admin; transfer = mkTransfer 0.0; extraArgs = xargs
  -- duplicate input holding cids
  let dupTransfer = (mkTransfer 30.0) with
        inputHoldingCids =
          [ toInterfaceContractId @HoldingV1.Holding aliceToken
          , toInterfaceContractId @HoldingV1.Holding aliceToken
          ]
  submitMustFail (actAs alice <> disclosures) $ exerciseCmd factoryCid TransferFactory_Transfer with
    expectedAdmin = admin; transfer = dupTransfer; extraArgs = xargs
  -- locked holding passed as an input
  lockedTok <- mintToken cfg admin alice 10.0
  locked <- submit (actAs [alice, admin] <> disclose cfgDisclosure) $ exerciseCmd cfg InstrumentConfig_LockHolding with
    owner = alice; tokenCid = lockedTok; holders = [admin]; expiresAt = later
  let lockedTransfer = (mkTransfer 5.0) with
        inputHoldingCids = [toInterfaceContractId @HoldingV1.Holding locked]
  submitMustFail (actAs alice <> disclosures) $ exerciseCmd factoryCid TransferFactory_Transfer with
    expectedAdmin = admin; transfer = lockedTransfer; extraArgs = xargs

-- A preapproval past its expiresAt cannot fund a direct transfer: the send
-- choice enforces the deadline, so the transfer is rejected.
directTransferRejectsExpiredPreapproval : Script ()
directTransferRejectsExpiredPreapproval = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"

  cfg <- registerInstrument admin "CC" "Canton Coin" "CC" 10 None
  aliceToken <- mintToken cfg admin alice 100.0

  let start = time (date 2026 Jan 1) 0 0 0
      preExpiry = time (date 2026 Jan 2) 0 0 0
      afterExpiry = time (date 2026 Jan 3) 0 0 0
  pre <- submit (actAs [admin, bob]) $ exerciseCmd cfg InstrumentConfig_Preapprove with
    receiver = bob; validFrom = start; expiresAt = preExpiry
  setTime afterExpiry
  let factoryCid = toInterfaceContractId @TransferFactory cfg
      transfer = Transfer with
        sender = alice; receiver = bob; amount = 30.0
        instrumentId = mkInstrumentId admin "CC"
        requestedAt = start; executeBefore = time (date 2026 Jan 4) 0 0 0
        inputHoldingCids = [toInterfaceContractId @HoldingV1.Holding aliceToken]
        meta = emptyMetadata
      ctx = ChoiceContext with
        values = TextMap.fromList [(preapprovalContextKey, AV_ContractId (coerceContractId pre))]
  Some cfgDisclosure <- queryDisclosure admin cfg
  Some preDisclosure <- queryDisclosure admin pre
  submitMustFail (actAs alice <> disclose cfgDisclosure <> disclose preDisclosure) $
    exerciseCmd factoryCid TransferFactory_Transfer with
      expectedAdmin = admin; transfer; extraArgs = ExtraArgs with context = ctx; meta = emptyMetadata
