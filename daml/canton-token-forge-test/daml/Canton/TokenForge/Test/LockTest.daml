module Canton.TokenForge.Test.LockTest where

import Daml.Script
import DA.Assert ((===))
import DA.Time (time)
import DA.Date (date, Month(Jan))
import Splice.Api.Token.HoldingV1 qualified as HoldingV1
import Splice.Api.Token.MetadataV1 (emptyMetadata)
import Canton.TokenForge.Registry (InstrumentConfig_Transfer(..))
import Canton.TokenForge.Transfer (TokenTransfer(..), TokenTransferOutput(..), TokenLock(..))
import Canton.TokenForge.Locked (LockedToken(..), LockedToken_Unlock(..), LockedToken_ExpireLock(..))
import Canton.TokenForge.Test.Util (registerInstrument, mintToken, lockToken)

lockThenUnlock : Script ()
lockThenUnlock = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  cfg <- registerInstrument admin "CC" "CC" "CC" 10 None
  tok <- mintToken cfg admin alice 50.0

  let expiresAt = time (date 2026 Jan 2) 0 0 0
  lockedCid <- lockToken cfg admin alice tok [admin] expiresAt
  -- the locked holding exposes lock in its Holding view
  let lhcid = toInterfaceContractId @HoldingV1.Holding lockedCid
  Some lv <- queryInterfaceContractId alice lhcid
  ((.holders) <$> lv.lock) === Some [admin]
  lv.amount === 50.0
  -- holder unlocks, returning a Token to the owner
  back <- submit (actAs [alice, admin]) $ exerciseCmd lockedCid LockedToken_Unlock
  Some hv <- queryInterfaceContractId alice (toInterfaceContractId @HoldingV1.Holding back.tokenCid)
  hv.owner === alice
  hv.amount === 50.0

-- Negative + expiry paths.
lockRejectsAndExpires : Script ()
lockRejectsAndExpires = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  cfg <- registerInstrument admin "CC" "CC" "CC" 10 None
  tok <- mintToken cfg admin alice 50.0

  let expiresAt = time (date 2026 Jan 2) 0 0 0
  lockedCid <- lockToken cfg admin alice tok [admin] expiresAt
  -- the owner alone cannot unlock; a holder (admin) must co-authorize
  submitMustFail alice $ exerciseCmd lockedCid LockedToken_Unlock
  -- owner cannot reclaim before expiry (ledger time is still 1970)
  submitMustFail alice $ exerciseCmd lockedCid LockedToken_ExpireLock
  -- at expiry the owner reclaims a Token; expiresAt itself is the earliest
  -- instant that works, and the only one a strictly-after check would refuse
  setTime expiresAt
  back <- submit alice $ exerciseCmd lockedCid LockedToken_ExpireLock
  Some hv <- queryInterfaceContractId alice (toInterfaceContractId @HoldingV1.Holding back.tokenCid)
  hv.owner === alice
  hv.amount === 50.0

-- Holders sign the lock, so an owner cannot bind a holder that did not
-- authorize it. charlie is named as a lock holder but does not act, and the
-- controller set the transfer computes includes him, so the submission fails
-- before anything is fetched.
lockRequiresHolderConsent : Script ()
lockRequiresHolderConsent = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  charlie <- allocateParty "charlie"
  cfg <- registerInstrument admin "CC" "CC" "CC" 10 None
  tok <- mintToken cfg admin alice 50.0
  let expiresAt = time (date 2026 Jan 2) 0 0 0
  Some cfgDisclosure <- queryDisclosure admin cfg
  submitMustFail (actAs alice <> disclose cfgDisclosure) $
    exerciseCmd cfg InstrumentConfig_Transfer with
      expectedAdmin = admin
      transfer = TokenTransfer with
        sender = alice
        inputs = [tok]
        outputs =
          [ TokenTransferOutput with
              receiver = alice; amount = 50.0
              lock = Some TokenLock with holders = [charlie]; expiresAt; optContext = None
              meta = emptyMetadata
          ]

-- The lock context is what a wallet shows a user as the reason a holding is
-- locked, so it has to survive the trip through the standard Holding view.
-- Both LockedTokens here are created directly, so the view is exercised
-- without going through a choice.
lockContextSurfacesInView : Script ()
lockContextSurfacesInView = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  let expiresAt = time (date 2026 Jan 2) 0 0 0
  tagged <- submit (actAs [alice, admin]) $ createCmd LockedToken with
    admin; owner = alice; instrumentId = "CC"; amount = 50.0
    holders = [admin]; expiresAt; optContext = Some "vesting-escrow"
    meta = emptyMetadata
  Some tv <- queryInterfaceContractId alice (toInterfaceContractId @HoldingV1.Holding tagged)
  ((.context) <$> tv.lock) === Some (Some "vesting-escrow")

  untagged <- submit (actAs [alice, admin]) $ createCmd LockedToken with
    admin; owner = alice; instrumentId = "CC"; amount = 50.0
    holders = [admin]; expiresAt; optContext = None
    meta = emptyMetadata
  Some uv <- queryInterfaceContractId alice (toInterfaceContractId @HoldingV1.Holding untagged)
  ((.context) <$> uv.lock) === Some None
