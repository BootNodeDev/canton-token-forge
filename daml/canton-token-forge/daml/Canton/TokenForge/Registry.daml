module Canton.TokenForge.Registry where

import DA.TextMap qualified as TextMap
import Splice.Api.Token.HoldingV1 qualified as HoldingV1
import Splice.Api.Token.MetadataV1 (Metadata, emptyMetadata, ChoiceContext(..), AnyValue(..))
import Splice.Api.Token.TransferInstructionV1
import Splice.Api.Token.AllocationInstructionV1
import Splice.Api.Token.BurnMintV1
import Canton.TokenForge.Token (Token(..), mkToken, consumeInputs, spendInputs)
import Canton.TokenForge.Locked (LockedToken(..))
import Canton.TokenForge.Instruction (TokenTransferInstruction(..))
import Canton.TokenForge.Allocation (allocateImpl)
import Canton.TokenForge.Types (mkInstrumentId)

-- | Faucet policy for an instrument.
data FaucetConfig = FaucetConfig
  with
    maxPerTap : Decimal
  deriving (Eq, Show)

-- | Operator-owned registry anchor. Serves as the getRegistryInfo identity
-- (registryBaseUrl) for the metadata API and the creation entry point:
-- instruments are proposed through TokenRegistry_ProposeInstrument (admin) and
-- finalized by the operator accepting the resulting InstrumentConfigProposal.
-- Signed by the operator.
template TokenRegistry
  with
    operator : Party
    registryBaseUrl : Text
  where
    signatory operator

    -- Admin proposes an instrument through the registry. The operator identity
    -- is taken from the registry contract, not an argument, so every proposal is
    -- bound to this registry's real operator. Admin authority to create the
    -- admin-signed proposal comes from the admin controller; the admin must have
    -- this operator-signed registry disclosed to exercise the choice.
    nonconsuming choice TokenRegistry_ProposeInstrument : ContractId InstrumentConfigProposal
      with
        admin : Party
        instrumentId : Text
        name : Text
        symbol : Text
        decimals : Int
        faucet : Optional FaucetConfig
      controller admin
      do
        create InstrumentConfigProposal with
          admin; operator; instrumentId; name; symbol; decimals; faucet

-- | An admin's request to register an instrument, pending the operator's
-- approval. Created only via TokenRegistry_ProposeInstrument. Splitting
-- registration into propose (admin) then accept (operator) gives the operator an
-- explicit gate: it can decline a duplicate (admin, instrumentId) or any request
-- failing an off-ledger policy check before an InstrumentConfig exists. The
-- uniqueness check itself is off-ledger (the operator's registry service runs it
-- before accepting), because LF 2.1 has no contract keys and a choice cannot
-- enumerate other InstrumentConfigs.
template InstrumentConfigProposal
  with
    admin : Party
    operator : Party
    instrumentId : Text
    name : Text
    symbol : Text
    decimals : Int
    faucet : Optional FaucetConfig
  where
    signatory admin
    observer operator
    ensure decimals >= 0 && decimals <= 18

    -- Operator approves: creates the admin-signed InstrumentConfig. The admin
    -- authority flows from this proposal's admin signatory; the operator
    -- authority from being the accepting controller.
    choice InstrumentConfigProposal_Accept : ContractId InstrumentConfig
      controller operator
      do
        create InstrumentConfig with
          admin; operator; instrumentId; name; symbol; decimals; faucet
          meta = emptyMetadata

    -- Operator declines the request.
    choice InstrumentConfigProposal_Reject : ()
      controller operator
      do pure ()

    -- Admin retracts a still-pending request.
    choice InstrumentConfigProposal_Withdraw : ()
      controller admin
      do pure ()

-- | Receiver opt-in that enables direct (1-step) transfers to them.
template TokenTransferPreapproval
  with
    admin : Party
    instrumentId : Text
    receiver : Party
  where
    signatory admin, receiver

-- | Per-instrument rules/factory contract (the AmuletRules analog). Signed by
-- the instrument admin; the operator is an observer. Implements the standard
-- factory interfaces.
template InstrumentConfig
  with
    admin : Party
    operator : Party
    instrumentId : Text
    name : Text
    symbol : Text
    decimals : Int
    faucet : Optional FaucetConfig
    meta : Metadata
  where
    signatory admin
    observer operator
    ensure decimals >= 0 && decimals <= 18

    -- Free minting (no economics), co-authorized by the recipient so a holding
    -- is never created for a party that did not consent (Amulet AmuletRules_Mint,
    -- controller dso, receiver). Self-mint (recipient == admin) is unaffected.
    nonconsuming choice InstrumentConfig_Mint : ContractId Token
      with
        recipient : Party
        amount : Decimal
      controller admin, recipient
      do
        create (mkToken admin recipient instrumentId amount emptyMetadata)

    -- Owner-consented locking; admin authority flows from this admin-signed config.
    nonconsuming choice InstrumentConfig_LockHolding : ContractId LockedToken
      with
        owner : Party
        tokenCid : ContractId Token
        holders : [Party]
        expiresAt : Time
      controller owner
      do
        token <- fetch tokenCid
        assertMsg "token belongs to this instrument" (token.admin == admin && token.instrumentId == instrumentId)
        assertMsg "caller must own the token" (token.owner == owner)
        archive tokenCid
        create LockedToken with
          admin; owner; instrumentId; amount = token.amount; holders; expiresAt; meta = token.meta

    nonconsuming choice InstrumentConfig_Preapprove : ContractId TokenTransferPreapproval
      with
        receiver : Party
      controller admin, receiver
      do create TokenTransferPreapproval with admin; instrumentId; receiver

    -- Self-service faucet. Enabled only when `faucet` is set; capped per tap.
    nonconsuming choice InstrumentConfig_Tap : ContractId Token
      with
        user : Party
        amount : Decimal
      controller user
      do
        case faucet of
          None -> abort "faucet is not enabled for this instrument"
          Some fc -> do
            assertMsg "tap amount must be positive" (amount > 0.0)
            assertMsg "tap amount exceeds per-tap cap" (amount <= fc.maxPerTap)
            create (mkToken admin user instrumentId amount emptyMetadata)

    interface instance TransferFactory for InstrumentConfig where
      view = TransferFactoryView with admin; meta = emptyMetadata

      transferFactory_transferImpl _self arg = transferImpl admin instrumentId arg

      transferFactory_publicFetchImpl _self arg = do
        assertMsg "expectedAdmin must match" (arg.expectedAdmin == admin)
        pure (view $ toInterface @TransferFactory this)

    interface instance AllocationFactory for InstrumentConfig where
      view = AllocationFactoryView with admin; meta = emptyMetadata

      allocationFactory_allocateImpl _self arg = allocateImpl admin instrumentId arg

      allocationFactory_publicFetchImpl _self arg = do
        assertMsg "expectedAdmin must match" (arg.expectedAdmin == admin)
        pure (view $ toInterface @AllocationFactory this)

    interface instance BurnMintFactory for InstrumentConfig where
      view = BurnMintFactoryView with admin; meta = emptyMetadata

      burnMintFactory_burnMintImpl _self arg = do
        let BurnMintFactory_BurnMint{expectedAdmin, instrumentId = argInstrumentId, inputHoldingCids, outputs} = arg
        assertMsg "expectedAdmin must match" (expectedAdmin == admin)
        assertMsg "instrumentId must match this config" (argInstrumentId == mkInstrumentId admin instrumentId)

        -- Burn every input. This is admin-authorized reissuance, so inputs are
        -- validated against the instrument but not against a single owner.
        _ <- consumeInputs admin instrumentId None inputHoldingCids

        outputCids <- forA outputs \o -> do
          assertMsg "output amount must be positive" (o.amount > 0.0)
          c <- create (mkToken admin o.owner instrumentId o.amount emptyMetadata)
          pure (toInterfaceContractId @HoldingV1.Holding c)
        pure BurnMintFactory_BurnMintResult with outputCids

      burnMintFactory_publicFetchImpl _self arg = do
        assertMsg "expectedAdmin must match" (arg.expectedAdmin == admin)
        pure (view $ toInterface @BurnMintFactory this)

-- | Well-known choice-context key under which the app backend supplies the
-- receiver's TokenTransferPreapproval cid to enable a direct transfer.
preapprovalContextKey : Text
preapprovalContextKey = "canton-token-forge/transfer-preapproval"

-- | Look up the optional preapproval cid the backend put in the choice context.
lookupPreapprovalCid : ChoiceContext -> Optional (ContractId TokenTransferPreapproval)
lookupPreapprovalCid ctx =
  case TextMap.lookup preapprovalContextKey ctx.values of
    Some (AV_ContractId acid) -> Some (coerceContractId acid)
    _ -> None

-- | Direct (1-step) is allowed for self-transfers, or when the context carries a
-- valid preapproval for this instrument's receiver. The preapproval cid is
-- supplied by the app backend and must be disclosed to the sender: an absent cid
-- takes the two-step offer path, but a present-but-stale or undisclosed cid makes
-- the fetch abort the whole transfer, since a failed fetch cannot be recovered
-- from inside a choice.
isDirectTransfer : Party -> Text -> Transfer -> ChoiceContext -> Update Bool
isDirectTransfer admin instrumentId transfer ctx
  | transfer.sender == transfer.receiver = pure True
  | otherwise = case lookupPreapprovalCid ctx of
      None -> pure False
      Some pcid -> do
        pre <- fetch pcid
        pure (pre.admin == admin && pre.instrumentId == instrumentId && pre.receiver == transfer.receiver)

transferImpl
  : Party    -- ^ admin (config signatory)
  -> Text    -- ^ instrumentId
  -> TransferFactory_Transfer
  -> Update TransferInstructionResult
transferImpl admin instrumentId arg = do
  let TransferFactory_Transfer{expectedAdmin, transfer, extraArgs} = arg
  assertMsg "expectedAdmin must match the instrument admin" (expectedAdmin == admin)
  assertMsg "transfer instrument must match this config" (transfer.instrumentId == mkInstrumentId admin instrumentId)
  assertMsg "amount must be positive" (transfer.amount > 0.0)
  now <- getTime
  assertMsg "transfer requestedAt must be in the past" (transfer.requestedAt <= now)
  assertMsg "transfer has expired (executeBefore reached)" (now < transfer.executeBefore)

  senderChangeCids <- spendInputs admin instrumentId transfer.sender transfer.inputHoldingCids transfer.amount

  direct <- isDirectTransfer admin instrumentId transfer extraArgs.context
  if direct
    then do
      receiverCid <- create (mkToken admin transfer.receiver instrumentId transfer.amount transfer.meta)
      pure TransferInstructionResult with
        output = TransferInstructionResult_Completed with
          receiverHoldingCids = [toInterfaceContractId @HoldingV1.Holding receiverCid]
        senderChangeCids
        meta = emptyMetadata
    else do
      -- Escrow is sender-owned so reject/withdraw can return it. After expiry the
      -- sender can also reclaim it directly via LockedToken_ExpireLock, which
      -- leaves this instruction inert: the funds are safe (already returned) but
      -- the pending offer is not cleared.
      locked <- create LockedToken with
        admin; owner = transfer.sender; instrumentId; amount = transfer.amount
        holders = [admin]; expiresAt = transfer.executeBefore; meta = transfer.meta
      instr <- create TokenTransferInstruction with admin; transfer; lockedCid = locked
      pure TransferInstructionResult with
        output = TransferInstructionResult_Pending with
          transferInstructionCid = toInterfaceContractId @TransferInstruction instr
        senderChangeCids
        meta = emptyMetadata
