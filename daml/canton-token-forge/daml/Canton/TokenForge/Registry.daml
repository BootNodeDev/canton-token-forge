module Canton.TokenForge.Registry where

import Splice.Api.Token.MetadataV1 (Metadata, emptyMetadata)
import Splice.Api.Token.TransferInstructionV1
import Canton.TokenForge.Token (Token(..))
import Canton.TokenForge.Transfer (transferDirectImpl)
import Canton.TokenForge.Locked (LockedToken(..))

-- | Faucet policy for an instrument.
data FaucetConfig = FaucetConfig
  with
    maxPerTap : Decimal
  deriving (Eq, Show)

-- | Operator-owned registry anchor. Serves as the getRegistryInfo identity and
-- the creation entry point for instruments. Signed by the operator.
template TokenRegistry
  with
    operator : Party
    registryBaseUrl : Text
  where
    signatory operator

    -- Admin co-authorizes so the admin-signed InstrumentConfig can be created.
    nonconsuming choice TokenRegistry_RegisterInstrument : ContractId InstrumentConfig
      with
        admin : Party
        instrumentId : Text
        name : Text
        symbol : Text
        decimals : Int
        faucet : Optional FaucetConfig
      controller operator, admin
      do
        create InstrumentConfig with
          admin; operator; instrumentId; name; symbol; decimals; faucet
          meta = emptyMetadata

-- | Per-instrument rules/factory contract (the AmuletRules analog). Signed by
-- the instrument admin; the operator is an observer. Implements the standard
-- factory interfaces.
template InstrumentConfig
  with
    admin : Party
    operator : Party
    instrumentId : Text
    name : Text
    symbol : Text
    decimals : Int
    faucet : Optional FaucetConfig
    meta : Metadata
  where
    signatory admin
    observer operator
    ensure decimals >= 0 && decimals <= 18

    -- Free admin minting (no economics).
    nonconsuming choice InstrumentConfig_Mint : ContractId Token
      with
        recipient : Party
        amount : Decimal
      controller admin
      do
        create Token with
          admin; owner = recipient; instrumentId; amount; meta = emptyMetadata

    -- Owner-consented locking; admin authority flows from this admin-signed config.
    nonconsuming choice InstrumentConfig_LockHolding : ContractId LockedToken
      with
        owner : Party
        tokenCid : ContractId Token
        holders : [Party]
        expiresAt : Time
      controller owner
      do
        token <- fetch tokenCid
        assertMsg "token belongs to this instrument" (token.admin == admin && token.instrumentId == instrumentId)
        assertMsg "caller must own the token" (token.owner == owner)
        archive tokenCid
        create LockedToken with
          admin; owner; instrumentId; amount = token.amount; holders; expiresAt; meta = emptyMetadata

    interface instance TransferFactory for InstrumentConfig where
      view = TransferFactoryView with admin; meta = emptyMetadata

      transferFactory_transferImpl _self arg = transferDirectImpl admin instrumentId arg

      transferFactory_publicFetchImpl _self arg = do
        assertMsg "expectedAdmin must match" (arg.expectedAdmin == admin)
        pure (view $ toInterface @TransferFactory this)
