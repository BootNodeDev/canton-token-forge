module Canton.TokenForge.Locked where

import Splice.Api.Token.HoldingV1 qualified as HoldingV1
import Splice.Api.Token.MetadataV1 (Metadata)
import Canton.TokenForge.Token (Token(..), mkToken)
import Canton.TokenForge.Types (mkInstrumentId)

-- | A locked holding of a canton-token-forge instrument (the LockedAmulet
-- analog, signatory lock.holders, amulet). Co-signed by the admin, the owner,
-- and the lock holders, so a holder is never bound into a lock it did not
-- authorize.
template LockedToken
  with
    admin : Party
    owner : Party
    instrumentId : Text
    amount : Decimal
    holders : [Party]
    expiresAt : Time
    meta : Metadata
  where
    signatory admin, owner, holders
    ensure amount > 0.0

    interface instance HoldingV1.Holding for LockedToken where
      view = HoldingV1.HoldingView with
        owner
        instrumentId = mkInstrumentId admin instrumentId
        amount
        lock = Some HoldingV1.Lock with
          holders; expiresAt = Some expiresAt; expiresAfter = None; context = None
        meta

    -- Cooperative release (Amulet LockedAmulet_UnlockV2): owner and holders
    -- jointly. In every escrow abort path the escrow's parent is signed by both
    -- admin and sender, so owner and holder (admin) authority are already in
    -- scope and this is satisfied for free.
    choice LockedToken_Unlock : ContractId Token
      controller owner :: holders
      do create (mkToken admin owner instrumentId amount meta)

    -- After expiry the owner can reclaim the funds.
    choice LockedToken_ExpireLock : ContractId Token
      controller owner
      do
        now <- getTime
        assertMsg "lock has not expired yet" (now >= expiresAt)
        create (mkToken admin owner instrumentId amount meta)

-- | Release a locked holding back to its owner as a spendable Holding via the
-- lock's own unlock choice. Shared by the transfer reject/withdraw path and the
-- allocation withdraw/cancel path so the two stay in step.
unlockHolding : ContractId LockedToken -> Update (ContractId HoldingV1.Holding)
unlockHolding lockedCid = do
  tokenCid <- exercise lockedCid LockedToken_Unlock
  pure (toInterfaceContractId @HoldingV1.Holding tokenCid)
