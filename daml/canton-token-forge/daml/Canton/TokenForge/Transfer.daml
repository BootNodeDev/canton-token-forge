-- | The multi-output transfer (the Splice.AmuletRules analog): the one
-- mechanism the CN Token Standard v1 cannot express, since HoldingV1 declares
-- no choices and its Lock is view-only metadata. Registry.daml declares the
-- choice and calls in here, the way it delegates allocation to Allocation.daml.
module Canton.TokenForge.Transfer where

import DA.Assert (assertWithinDeadline)
import DA.List (dedup, dedupSort)
import Splice.Api.Token.HoldingV1 qualified as HoldingV1
import Splice.Api.Token.MetadataV1 (Metadata, emptyMetadata)
import Canton.TokenForge.Token (Token, mkToken, consumeInputs)
import Canton.TokenForge.Locked (LockedToken(..))
import Canton.TokenForge.TxMeta (TxKind(..), holdingTxMeta)

-- | Splice.Expiry.TimeLock.
data TokenLock = TokenLock
  with
    holders : [Party]
    expiresAt : Time
    optContext : Optional Text
  deriving (Eq, Show)

-- | AmuletRules.TransferOutput. `meta` has no Amulet counterpart: an amulet's
-- metadata is derived from its economics, ours is a template field, and without
-- it a lock output would silently drop the memo a holding carries.
data TokenTransferOutput = TokenTransferOutput
  with
    receiver : Party
    amount : Decimal
    lock : Optional TokenLock
    meta : Metadata
  deriving (Eq, Show)

-- | AmuletRules.Transfer. Inputs are Token contract ids directly, since
-- InputAmulet is the only Amulet input variant with an analog here.
data TokenTransfer = TokenTransfer
  with
    sender : Party
    inputs : [ContractId Token]
    outputs : [TokenTransferOutput]
  deriving (Eq, Show)

-- | AmuletRules.CreatedAmulet. Returned in `outputs` order, because the ported
-- vesting code pattern matches on it positionally.
data CreatedHolding
  = TransferResultToken (ContractId Token)
  | TransferResultLockedToken (ContractId LockedToken)
  deriving (Eq, Show)

-- | AmuletRules.transferControllers, minus the `provider` entry we have no use
-- for. Every party a transfer would bind into a holding is here, and it is
-- computed from the argument alone, so a receiver or a lock holder can never be
-- given a holding without authorizing the transaction that creates it.
tokenTransferControllers : TokenTransfer -> [Party]
tokenTransferControllers transfer =
    dedup (transfer.sender :: concatMap outputParties transfer.outputs)
  where
    outputParties o = o.receiver :: optional [] (.holders) o.lock

-- | Archive the sender's inputs, create the outputs in order, and return any
-- leftover input value to the sender as change (which carries no memo, being
-- the sender's own funds rather than delivered value).
--
-- consumeInputs does the whole input half: it rejects duplicates, rejects
-- anything that is not a spendable Token of this instrument, and requires every
-- input to be owned by the sender. Its Holding-interface parameter is why the
-- input cids are upcast here; a caller that coerced a LockedToken cid into a
-- ContractId Token still lands in the rejecting branch, which is what keeps an
-- in-flight escrow unreachable through this door.
--
-- Amulet's maxNumInputs, maxNumOutputs and maxNumLockHolders caps are
-- deliberately not ported: they bound fee computation on TransferConfigV2, the
-- economics config this token has no analog of, and the standard's own factory
-- entry points here already take unbounded input lists.
executeTokenTransfer
  : Party    -- ^ admin (config signatory)
  -> Text    -- ^ instrumentId
  -> TokenTransfer
  -> Update ([CreatedHolding], Optional (ContractId Token))
executeTokenTransfer admin instrumentId transfer = do
  amounts <- consumeInputs admin instrumentId transfer.sender
    (map (toInterfaceContractId @HoldingV1.Holding) transfer.inputs)
  let inputTotal = sum amounts
      outputTotal = sum (map (.amount) transfer.outputs)
  assertMsg "outputs must not exceed the inputs" (inputTotal >= outputTotal)

  createdHoldings <- forA transfer.outputs \o -> do
    assertMsg "output amount must be positive" (o.amount > 0.0)
    case o.lock of
      None -> TransferResultToken <$>
        create (mkToken admin o.receiver instrumentId o.amount o.meta)
      Some l -> TransferResultLockedToken <$> do
        -- A lock at or past its expiry is one LockedToken_ExpireLock away from
        -- being the owner's again, so creating one escrows nothing.
        assertWithinDeadline "lock.expiresAt" l.expiresAt
        create LockedToken with
          admin; owner = o.receiver; instrumentId; amount = o.amount
          holders = dedupSort (filter (/= o.receiver) l.holders)
          expiresAt = l.expiresAt; optContext = l.optContext
          meta = o.meta

  senderChangeCid <-
    if inputTotal > outputTotal
      then Some <$> create (mkToken admin transfer.sender instrumentId (inputTotal - outputTotal) emptyMetadata)
      else pure None
  pure (createdHoldings, senderChangeCid)

-- | Classify a transfer for the standard's history parser, ported from
-- Splice.AmuletRules. A transfer whose every output stays under the sender's
-- control moved nothing, so it reads as a merge or a split and names no sender;
-- anything else is a payment and must name one, since the parser cannot read a
-- sender off a registry-native choice argument.
tokenTransferTxMeta : TokenTransfer -> Metadata
tokenTransferTxMeta transfer
  | all senderRetainsControl transfer.outputs = holdingTxMeta TxKind_MergeSplit None None
  | otherwise = holdingTxMeta TxKind_Transfer None (Some transfer.sender)
  where
    senderRetainsControl o = transfer.sender == o.receiver && case o.lock of
      None -> True
      Some l -> all (transfer.sender ==) l.holders
