module Canton.TokenForge.Instruction where

import Splice.Api.Token.HoldingV1 qualified as HoldingV1
import Splice.Api.Token.MetadataV1 (emptyMetadata)
import Splice.Api.Token.TransferInstructionV1
import Canton.TokenForge.Token (mkToken)
import Canton.TokenForge.Locked (LockedToken(..), LockedToken_Unlock(..))

-- | Unlocks the escrow back to the sender, used by both reject and withdraw.
returnToSender : ContractId LockedToken -> Update TransferInstructionResult
returnToSender lockedCid = do
  backCid <- exercise lockedCid LockedToken_Unlock
  pure TransferInstructionResult with
    output = TransferInstructionResult_Failed
    senderChangeCids = [toInterfaceContractId @HoldingV1.Holding backCid]
    meta = emptyMetadata

-- | The two-step transfer offer (the LockedAmulet-and-TransferInProgress
-- analog): escrows the sender's funds pending the receiver's decision.
template TokenTransferInstruction
  with
    admin : Party
    transfer : Transfer
    lockedCid : ContractId LockedToken
  where
    signatory admin, transfer.sender
    observer transfer.receiver

    interface instance TransferInstruction for TokenTransferInstruction where
      view = TransferInstructionView with
        originalInstructionCid = None
        transfer
        status = TransferPendingReceiverAcceptance
        meta = transfer.meta

      transferInstruction_acceptImpl _self _arg = do
        now <- getTime
        assertMsg "transfer has expired (executeBefore reached)" (now < transfer.executeBefore)
        archive lockedCid
        receiverCid <- create (mkToken admin transfer.receiver transfer.instrumentId.id transfer.amount transfer.meta)
        pure TransferInstructionResult with
          output = TransferInstructionResult_Completed with
            receiverHoldingCids = [toInterfaceContractId @HoldingV1.Holding receiverCid]
          senderChangeCids = []
          meta = emptyMetadata

      transferInstruction_rejectImpl _self _arg = returnToSender lockedCid
      transferInstruction_withdrawImpl _self _arg = returnToSender lockedCid
      transferInstruction_updateImpl _self _arg = abort "update not supported"
