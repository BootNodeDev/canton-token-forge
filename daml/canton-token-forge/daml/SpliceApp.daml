module SpliceApp where

-- Minimal sample template. Replace with your real contracts; it exists so a
-- freshly generated project produces a real DAR that the test package can
-- data-depend on. The production package declares splice-amulet as a
-- data-dependency (see daml.yaml) so `import Splice.Amulet (...)` works here.
template Greeting
  with
    owner : Party
    message : Text
  where
    signatory owner

    choice Greeting_SetMessage : ContractId Greeting
      with newMessage : Text
      controller owner
      do create this with message = newMessage
